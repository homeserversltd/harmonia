{
  "schema": "harmonia.module.ladder.v1",
  "id": "hermes-cua-driver-service",
  "title": "Hermes CUA service",
  "summary": "Offers the CUA Driver user service on the Hermes private desktop runtime.",
  "category": "interactable",
  "version": "1.0.0",
  "description": "Compile the Ubuntu-only CUA Driver user unit; birth owns its linger activation and private runtime directories.",
  "optional": false,
  "config_deploy": "interactable",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "hermes-cua-driver-user-unit",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/service",
        "target_path": "/home/hermes/.config/systemd/user/cua-driver.service",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    }
  ]
}
