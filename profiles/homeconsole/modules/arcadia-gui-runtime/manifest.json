{
  "schema": "harmonia.module.ladder.v1",
  "id": "arcadia-gui-runtime",
  "version": "3.6.0",
  "description": "Arcadia is the HomeConsole front panel and must execute declared local appliance controls through Harmonia/systemd.",
  "constants": {},
  "ladder": [
    {
      "step_id": "arcadia-gui-service-runtime",
      "tool": "service-runtime",
      "permutation": "converge",
      "args": {
        "module_id": "arcadia-gui-runtime",
        "component": "arcadia",
        "bearer": "owner",
        "source_dir": "/opt/arcadia/source",
        "install_bin": "/usr/local/bin/arcadia",
        "service": "arcadia.service",
        "url": "http://127.0.0.1:8080/health",
        "binary_name": "arcadia",
        "op_prefix": "arcadia-gui",
        "run_schema": "harmonia.arcadia_gui_runtime.v1",
        "managed_files_schema": "harmonia.arcadia_gui_runtime.managed_files.v1",
        "build_environment": {
          "RUSTUP_HOME": "/opt/rustup",
          "CARGO_HOME": "/opt/cargo"
        },
        "managed_files": [
          {
            "path": "/etc/systemd/system/arcadia.service.d/10-control-surface-authority.conf",
            "mode": 644,
            "content": "[Service]\nUser=\nGroup=\nNoNewPrivileges=false\n"
          }
        ],
        "expected_unit_properties": {
          "User": "root",
          "Group": "root",
          "NoNewPrivileges": "no"
        }
      },
      "on_failure": "stop"
    }
  ]
}
