{
  "schema": "harmonia.module.ladder.v1",
  "id": "homeconsole-tls-lifecycle",
  "version": "1.0.0",
  "description": "HomeConsole TLS lifecycle: observe leaf state, request only on difference, validate against installed house root, and retain the prior generation.",
  "constants": {},
  "ladder": [
    {
      "step_id": "homeconsole-tls-leaf",
      "tool": "tls-lifecycle",
      "permutation": "converge",
      "args": {
        "key_dir": "/var/lib/arcadia/tls",
        "key_path": "/var/lib/arcadia/tls/key.pem",
        "csr_path": "/var/lib/arcadia/tls/console.csr.pem",
        "leaf_path": "/var/lib/arcadia/tls/leaf.pem",
        "chain_path": "/var/lib/arcadia/tls/chain.pem",
        "root_path": "/etc/caduceus/house-root.pem",
        "signer_url": "https://homeserver.home.arpa/api/v1/cert/csr/sign",
        "attendance_file": "/home/owner/.caduceus/attendance",
        "identity": "console.home.arpa",
        "san_dns": "console.home.arpa",
        "san_ip": "192.168.123.19",
        "renew_before_secs": 2592000
      }
    }
  ]
}
