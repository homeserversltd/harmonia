{
  "schema": "harmonia.module.ladder.v1",
  "id": "console-session",
  "title": "Console session",
  "summary": "Owns the Steam Gaming Mode Wayland session entry and retires only /usr/local/bin/steam-gamescope-session; owns no SDDM file.",
  "category": "known-good",
  "version": "1.0.0",
  "description": "Converges the Steam Gaming Mode Wayland session entry and retires only /usr/local/bin/steam-gamescope-session; this module owns no SDDM file.",
  "optional": false,
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "steam-gamescope-session-desktop-entry",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "usr/share/wayland-sessions/steam-gamescope-wayland.desktop"
        ],
        "mode": 420,
        "backup_existing": false,
        "owner": "root",
        "group": "root",
        "receipt_name": "console-session-desktop-entry"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "retire-steam-gamescope-session-launcher",
      "tool": "files",
      "permutation": "remove",
      "args": {
        "target_root": "/usr/local/bin",
        "paths": [
          "steam-gamescope-session"
        ]
      },
      "on_failure": "stop"
    }
  ]
}
