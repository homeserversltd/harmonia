{
  "schema": "harmonia.module.ladder.v1",
  "id": "caduceus-storage-categories",
  "category": "known-good",
  "version": "1.0.1",
  "description": "Daily Caduceus storage categories scan timer.",
  "ladder": [
    {
      "step_id": "caduceus-storage-categories-config",
      "tool": "routine",
      "permutation": "execute",
      "steps": [
        {
          "name": "managed-files",
          "tool": "files",
          "permutation": "managed-files",
          "args": {
            "managed_files": [
              {
                "path": "/etc/systemd/system/caduceus-storage-categories.service",
                "mode": 420,
                "content": "[Unit]\nDescription=Daily Caduceus storage categories scan\n\n[Service]\nType=oneshot\nUser=caduceus\nGroup=caduceus\nExecStart=/usr/local/bin/caduceus storage categories scan\nNice=10\nIOSchedulingClass=idle\n"
              },
              {
                "path": "/etc/systemd/system/caduceus-storage-categories.timer",
                "mode": 420,
                "content": "[Unit]\nDescription=Daily Caduceus storage categories scan timer\n\n[Timer]\nOnCalendar=daily\nPersistent=true\nUnit=caduceus-storage-categories.service\n\n[Install]\nWantedBy=timers.target\n"
              }
            ]
          }
        }
      ],
      "on_failure": "stop"
    },
    {
      "step_id": "caduceus-storage-categories-units-valid",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/systemd-analyze",
        "args": [
          "verify",
          "/etc/systemd/system/caduceus-storage-categories.service",
          "/etc/systemd/system/caduceus-storage-categories.timer"
        ],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "caduceus-storage-categories-daemon-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "caduceus-storage-categories-timer-enable",
      "tool": "systemd",
      "permutation": "enable-now",
      "args": {
        "service": "caduceus-storage-categories.timer",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    }
  ]
}
