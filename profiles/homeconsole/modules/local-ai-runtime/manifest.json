{
  "schema": "harmonia.module.ladder.v1",
  "id": "local-ai-runtime",
  "version": "3.6.0",
  "description": "Local AI runtime ladder: package install, model/state directories, compatibility links, binary readback, service status readback.",
  "constants": {},
  "ladder": [
    {
      "step_id": "local-ai-directories",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/install",
        "args": [
          "-d",
          "/var/lib/arcadia/models",
          "/var/lib/arcadia"
        ],
        "timeout_secs": 60
      }
    },
    {
      "step_id": "local-ai-server-link",
      "tool": "files",
      "permutation": "symlink-converge",
      "args": {
        "source": "/usr/bin/llama-server",
        "target": "/usr/local/bin/llama-server",
        "required_source_kind": "regular-executable",
        "owner": "root",
        "group": "root"
      }
    },
    {
      "step_id": "local-ai-cli-link",
      "tool": "files",
      "permutation": "symlink-converge",
      "args": {
        "source": "/usr/bin/llama-cli",
        "target": "/usr/local/bin/llama-cli",
        "required_source_kind": "regular-executable",
        "owner": "root",
        "group": "root"
      }
    }
  ],
  "optional": true
}
