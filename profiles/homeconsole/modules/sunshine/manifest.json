{
  "schema": "harmonia.module.ladder.v1",
  "id": "sunshine",
  "category": "known-good",
  "version": "1.0.0",
  "optional": false,
  "description": "HomeConsole Sunshine streaming configuration and device-access rule.",
  "constants": {},
  "ladder": [
    {
      "step_id": "sunshine-user-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "home/steam/.config/sunshine/sunshine.conf"
        ],
        "backup_existing": true,
        "owner": "steam",
        "group": "steam",
        "receipt_name": "homeconsole-sunshine-user-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sunshine-device-access",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/udev/rules.d/60-sunshine.rules"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "homeconsole-sunshine-device-access"
      },
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
