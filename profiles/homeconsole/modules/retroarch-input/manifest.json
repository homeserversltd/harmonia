{
  "schema": "harmonia.module.ladder.v1",
  "id": "retroarch-input",
  "category": "known-good",
  "version": "1.0.1",
  "optional": false,
  "description": "HomeConsole RetroArch DualSense and Sunshine virtual-pad input mappings.",
  "constants": {},
  "ladder": [
    {
      "step_id": "retroarch-input-mappings",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "home/owner/.config/retroarch/autoconfig/udev/Sony Interactive Entertainment DualSense Wireless Controller.cfg",
          "home/owner/.config/retroarch/autoconfig/udev/Sunshine PS5 (virtual) pad.cfg"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "homeconsole-retroarch-input-mappings"
      },
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
