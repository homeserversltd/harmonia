{
  "schema": "harmonia.module.ladder.v1",
  "id": "hermes-seat",
  "title": "Assistant settings",
  "summary": "Keeps the existing assistant launcher and tools available with automatic actions disabled.",
  "category": "known-good",
  "version": "1.0.0",
  "description": "Bounded existing-runtime upkeep only: require the born Hermes source and venv launcher to exist, converge declared dependencies, and maintain a platform-selected wrapper with yolo disabled.",
  "optional": false,
  "constants": {
    "source_root": "/opt/hermes/hermes-agent",
    "hermes_home": "/home/owner/.hermes",
    "venv": "/opt/hermes/venv",
    "launcher": "/opt/hermes/venv/bin/hermes",
    "source_patterns": [
      "requirements*.txt",
      "pyproject.toml"
    ]
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "hermes-source-root-born",
      "tool": "ask",
      "permutation": "path-exists",
      "args": {
        "path": "$constants.source_root"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "hermes-venv-launcher-present",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "$constants.launcher",
        "receipt_label": "hermes-venv-launcher"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "hermes-existing-venv-dependencies",
      "tool": "venv",
      "permutation": "converge",
      "args": {
        "venv": "$constants.venv",
        "source_root": "$constants.source_root",
        "source_patterns": "$constants.source_patterns"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "hermes-platform-session-wrapper",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/hermes-wrapper",
        "target_path": "/usr/local/bin/hermes",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    }
  ]
}
