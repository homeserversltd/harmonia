#!/usr/bin/python3
import hashlib
import io
import json
import os
import stat
import sys
import tarfile
import time
import urllib.error
import urllib.request

MAX_ARCHIVE_BYTES = 134217728
MAX_BINARY_BYTES = 67108864
ENTRYPOINT_PATH = "/usr/local/bin/cua-driver"
ENTRYPOINT_PARENT = "/usr/local/bin"
ENTRYPOINT_NAME = "cua-driver"


class ReleaseError(Exception):
    pass


def read_bounded(response, limit):
    parts = []
    total = 0
    while True:
        chunk = response.read(min(65536, limit + 1 - total))
        if not chunk:
            break
        parts.append(chunk)
        total += len(chunk)
        if total > limit:
            raise ReleaseError("cua-release-size-limit-exceeded")
    return b"".join(parts)


def fetch_bytes(url, limit, accept):
    request = urllib.request.Request(
        url,
        headers={"Accept": accept, "User-Agent": "HomeConsole-desktop-maintenance"},
    )
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            return read_bounded(response, limit)
    except (OSError, urllib.error.URLError) as error:
        raise ReleaseError("cua-release-fetch-failed") from error


def release_asset_url(repository, tag, archive):
    if repository != "trycua/cua" or tag != "cua-driver-rs-v0.28.2" or archive != "cua-driver-rs-0.28.2-linux-x86_64.tar.gz":
        raise ReleaseError("cua-release-pin-arguments-invalid")
    api = "https://api.github.com/repos/" + repository + "/releases/tags/" + tag
    try:
        release = json.loads(fetch_bytes(api, 1048576, "application/vnd.github+json").decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as error:
        raise ReleaseError("cua-release-metadata-invalid") from error
    if not isinstance(release, dict) or release.get("tag_name") != tag:
        raise ReleaseError("cua-release-tag-mismatch")
    assets = release.get("assets")
    if not isinstance(assets, list):
        raise ReleaseError("cua-release-assets-missing")
    selected = [asset for asset in assets if isinstance(asset, dict) and asset.get("name") == archive]
    if len(selected) != 1:
        raise ReleaseError("cua-release-asset-not-unique")
    expected_url = "https://github.com/" + repository + "/releases/download/" + tag + "/" + archive
    if selected[0].get("browser_download_url") != expected_url:
        raise ReleaseError("cua-release-asset-url-mismatch")
    return expected_url


def extract_pinned_binary(repository, tag, archive, archive_sha256, member_name):
    if archive_sha256 != "8f3e5b669e2bcd98d0eecc64f40640aac77f358b6332a06abc6ee79991620f7d":
        raise ReleaseError("cua-release-archive-pin-invalid")
    if member_name != "cua-driver-rs-0.28.2-linux-x86_64/cua-driver":
        raise ReleaseError("cua-release-member-pin-invalid")
    url = release_asset_url(repository, tag, archive)
    archive_bytes = fetch_bytes(url, MAX_ARCHIVE_BYTES, "application/octet-stream")
    observed_archive_sha256 = hashlib.sha256(archive_bytes).hexdigest()
    if observed_archive_sha256 != archive_sha256:
        raise ReleaseError("cua-release-archive-digest-mismatch")
    try:
        with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode="r:gz") as bundle:
            matches = [item for item in bundle.getmembers() if item.name == member_name]
            if len(matches) != 1 or not matches[0].isreg() or matches[0].size <= 0 or matches[0].size > MAX_BINARY_BYTES:
                raise ReleaseError("cua-release-binary-member-invalid")
            stream = bundle.extractfile(matches[0])
            if stream is None:
                raise ReleaseError("cua-release-binary-member-unreadable")
            binary = stream.read(MAX_BINARY_BYTES + 1)
    except (tarfile.TarError, OSError) as error:
        raise ReleaseError("cua-release-archive-invalid") from error
    if not binary.startswith(b"\x7fELF") or len(binary) > MAX_BINARY_BYTES:
        raise ReleaseError("cua-release-binary-invalid")
    return binary, hashlib.sha256(binary).hexdigest()


def open_entrypoint_parent():
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open("/", flags)
    try:
        parts = ENTRYPOINT_PARENT.strip("/").split("/")
        if not parts or any(part in ("", ".", "..") for part in parts):
            raise ReleaseError("cua-release-entrypoint-parent-invalid")
        for part in parts:
            child = os.open(part, flags, dir_fd=descriptor)
            metadata = os.fstat(child)
            if (
                not stat.S_ISDIR(metadata.st_mode)
                or metadata.st_uid != 0
                or metadata.st_gid != 0
                or stat.S_IMODE(metadata.st_mode) & 0o022
            ):
                os.close(child)
                raise ReleaseError("cua-release-entrypoint-parent-custody-invalid")
            os.close(descriptor)
            descriptor = child
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def read_entrypoint_at(parent_fd):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(ENTRYPOINT_NAME, flags, dir_fd=parent_fd)
    except FileNotFoundError as error:
        raise ReleaseError("cua-release-entrypoint-birth-precondition-missing") from error
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1 or metadata.st_size <= 0 or metadata.st_size > MAX_BINARY_BYTES:
            raise ReleaseError("cua-release-entrypoint-birth-precondition-invalid")
        header = os.pread(descriptor, 4, 0)
        if header != b"\x7fELF":
            raise ReleaseError("cua-release-entrypoint-not-born-elf")
        digest = hashlib.sha256()
        offset = 0
        while offset < metadata.st_size:
            chunk = os.pread(descriptor, min(65536, metadata.st_size - offset), offset)
            if not chunk:
                raise ReleaseError("cua-release-entrypoint-read-short")
            digest.update(chunk)
            offset += len(chunk)
        return metadata, digest.hexdigest()
    finally:
        os.close(descriptor)


def validate_entrypoint():
    parent_fd = open_entrypoint_parent()
    try:
        metadata, _digest = read_entrypoint_at(parent_fd)
        return metadata.st_dev, metadata.st_ino
    finally:
        os.close(parent_fd)


def entrypoint_matches(expected_sha256):
    parent_fd = open_entrypoint_parent()
    try:
        metadata, observed_sha256 = read_entrypoint_at(parent_fd)
        return (
            observed_sha256 == expected_sha256
            and metadata.st_uid == 0
            and metadata.st_gid == 0
            and stat.S_IMODE(metadata.st_mode) == 0o755
        )
    finally:
        os.close(parent_fd)


def validate_binary_sha256(value):
    if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
        raise ReleaseError("cua-release-binary-digest-invalid")


def write_all(descriptor, data):
    offset = 0
    while offset < len(data):
        count = os.write(descriptor, data[offset:])
        if count <= 0:
            raise ReleaseError("cua-release-entrypoint-write-short")
        offset += count


def repair_entrypoint(binary, expected_sha256, original_identity):
    if os.geteuid() != 0:
        raise ReleaseError("cua-release-installer-not-root")
    if not binary.startswith(b"\x7fELF") or not binary or len(binary) > MAX_BINARY_BYTES:
        raise ReleaseError("cua-release-binary-invalid")
    if hashlib.sha256(binary).hexdigest() != expected_sha256:
        raise ReleaseError("cua-release-binary-digest-inconsistent")

    parent_fd = open_entrypoint_parent()
    temporary_name = None
    temporary_fd = None
    try:
        metadata, _observed_sha256 = read_entrypoint_at(parent_fd)
        if (metadata.st_dev, metadata.st_ino) != original_identity:
            raise ReleaseError("cua-release-entrypoint-changed-before-repair")
        for attempt in range(8):
            temporary_name = ".cua-driver-" + str(os.getpid()) + "-" + str(time.time_ns()) + "-" + str(attempt) + ".tmp"
            try:
                temporary_fd = os.open(
                    temporary_name,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
                    0o600,
                    dir_fd=parent_fd,
                )
                break
            except FileExistsError:
                temporary_name = None
        if temporary_fd is None or temporary_name is None:
            raise ReleaseError("cua-release-entrypoint-temp-create-failed")
        os.fchown(temporary_fd, 0, 0)
        os.fchmod(temporary_fd, 0o755)
        write_all(temporary_fd, binary)
        os.fsync(temporary_fd)
        os.close(temporary_fd)
        temporary_fd = None

        current, _current_sha256 = read_entrypoint_at(parent_fd)
        if (current.st_dev, current.st_ino) != original_identity:
            raise ReleaseError("cua-release-entrypoint-changed-before-promote")
        os.replace(
            temporary_name,
            ENTRYPOINT_NAME,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )
        temporary_name = None
        os.fsync(parent_fd)
        installed, installed_sha256 = read_entrypoint_at(parent_fd)
        if (
            installed_sha256 != expected_sha256
            or installed.st_uid != 0
            or installed.st_gid != 0
            or stat.S_IMODE(installed.st_mode) != 0o755
        ):
            raise ReleaseError("cua-release-entrypoint-readback-mismatch")
    finally:
        if temporary_fd is not None:
            os.close(temporary_fd)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
        os.close(parent_fd)


def main():
    if len(sys.argv) != 8:
        raise ReleaseError("cua-release-arguments-invalid")
    mode, repository, tag, archive, archive_sha256, member_name, binary_sha256 = sys.argv[1:]
    if mode not in ("observe", "apply"):
        raise ReleaseError("cua-release-mode-invalid")
    validate_binary_sha256(binary_sha256)

    if mode == "observe":
        sys.stdout.write("current" if entrypoint_matches(binary_sha256) else "drift")
        return 0
    if entrypoint_matches(binary_sha256):
        return 0
    original_identity = validate_entrypoint()
    started = time.monotonic()
    binary, extracted_sha256 = extract_pinned_binary(repository, tag, archive, archive_sha256, member_name)
    if extracted_sha256 != binary_sha256:
        raise ReleaseError("cua-release-binary-digest-mismatch")
    repair_entrypoint(binary, binary_sha256, original_identity)
    duration_ms = int((time.monotonic() - started) * 1000)
    sys.stdout.write(
        "cua-driver changed entrypoint=" + ENTRYPOINT_PATH
        + " sha256=" + binary_sha256
        + " duration_ms=" + str(duration_ms) + "\n"
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ReleaseError, OSError, ValueError) as error:
        signal = str(error) if isinstance(error, ReleaseError) else "cua-release-runtime-failure"
        sys.stderr.write(signal + "\n")
        raise SystemExit(1)
