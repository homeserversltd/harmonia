{
  "schema": "harmonia.module.ladder.v1",
  "id": "household-time",
  "title": "Accurate clock",
  "summary": "Keeps the household's time setting and device clock synchronized.",
  "category": "known-good",
  "version": "2.1.2",
  "optional": false,
  "description": "Household time watched consumer: applies only a fresh valid resolver fact and proves NTP through systemd.",
  "caduceus_commands": [
    "time set-timezone"
  ],
  "constants": {
    "resolver_time_state_url": "http://homeserver.home.arpa:3014/time/state"
  },
  "ladder": [
    {
      "step_id": "household-time-peer-state",
      "tool": "household-time",
      "permutation": "watch-and-set",
      "args": {
        "backend": "caduceus",
        "state_url": "$constants.resolver_time_state_url",
        "timeout_secs": 10
      }
    },
    {
      "step_id": "household-time-timesyncd-gateway",
      "tool": "files",
      "permutation": "managed-files",
      "args": {},
      "on_failure": "stop"
    },
    {
      "step_id": "household-time-enable-timesyncd",
      "tool": "systemd",
      "permutation": "enable-now",
      "args": {
        "service": "systemd-timesyncd.service",
        "timeout_secs": 15
      },
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
