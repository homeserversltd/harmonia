{
  "schema": "harmonia.module.ladder.v1",
  "id": "homeconsole-caduceus-public-lever",
  "version": "1.0.1",
  "description": "HomeConsole Caduceus public lever runtime. Rust owns caduceus source sync, cargo build, binary install, profile/policy/state convergence, caduceus.service standup, and HTTP health proof; this sidecar carries constants only.",
  "constants": {},
  "ladder": [
    {
      "step_id": "caduceus-bootstrap-source-from-declared-profile",
      "tool": "git-artifact",
      "permutation": "sync",
      "args": {
        "component": "caduceus",
        "path": "/opt/caduceus/source",
        "source_dir": "/opt/caduceus/source"
      }
    },
    {
      "step_id": "caduceus-staff-shelf-from-synced-source",
      "tool": "files",
      "permutation": "source-shelf-sweep",
      "args": {
        "source_root": "/opt/caduceus/source/data/staff-actuators",
        "shelf_source": "caduceus_staff",
        "target_shelf": "/usr/local/sbin/caduceus_staff",
        "launcher_source_root": "/opt/caduceus/source/data/staff-actuators",
        "launcher_target_root": "/usr/local/sbin",
        "launcher_pattern": "caduceus-*",
        "shelf_owner": "root",
        "shelf_group": "root",
        "shelf_directory_mode": 493,
        "shelf_file_mode": 420,
        "launcher_mode": 493,
        "prune": true
      }
    },
    {
      "step_id": "caduceus-service-runtime",
      "tool": "service-runtime",
      "permutation": "converge",
      "args": {
        "module_id": "homeconsole-caduceus-public-lever",
        "component": "caduceus",
        "source_dir": "/opt/caduceus/source",
        "install_bin": "/usr/local/bin/caduceus",
        "service": "caduceus.service",
        "url": "http://127.0.0.1:8787/health",
        "source_sha_file": "/var/lib/harmonia/state/caduceus.sha",
        "binary_name": "caduceus",
        "op_prefix": "caduceus",
        "run_schema": "harmonia.homeconsole.caduceus_public_lever.v1",
        "managed_files_schema": "harmonia.homeconsole.caduceus_managed_files.v1",
        "managed_files": [
          {
            "path": "/etc/systemd/system/caduceus.service",
            "mode": 420,
            "content": "[Unit]\nDescription=Caduceus LAN-open appliance API\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nExecStart=/usr/local/bin/caduceus serve\nEnvironment=CADUCEUS_BIND=0.0.0.0:8787\nEnvironment=PATH=/usr/local/sbin:/usr/local/bin:/usr/bin\nEnvironment=PYTHONPATH=/usr/local/sbin\nRestart=on-failure\nRestartSec=2\n\n[Install]\nWantedBy=multi-user.target\n"
          },
          {
            "path": "/var/lib/caduceus/venv/lib/python3.14/site-packages/caduceus-staff.pth",
            "mode": 420,
            "content": "/usr/local/sbin\n"
          },
          {
            "path": "/etc/caduceus/identity.json",
            "mode": 420,
            "content": "{\n  \"schema\": \"caduceus.identity.v1\",\n  \"device\": \"arch-gaming-console\",\n  \"profile\": \"console\",\n  \"mode\": \"console\",\n  \"public_surface\": true,\n  \"harmonia_profile\": \"/etc/harmonia/profiles/homeconsole/index.json\"\n}\n"
          },
          {
            "path": "/var/lib/caduceus/state.json",
            "mode": 420,
            "content": "{\n  \"schema\": \"caduceus.state.v1\",\n  \"services\": {\n    \"update\": {\n      \"enabled\": true,\n      \"timer\": \"harmonia.timer\"\n    }\n  }\n}\n"
          }
        ],
        "caduceus_profile_source": {
          "source": "profiles/console/index.yaml",
          "path": "/etc/caduceus/profile.yaml",
          "mode": 420,
          "insert_after_profile": "",
          "insert_after_mode": "",
          "append": ""
        }
      }
    }
  ]
}
