{
  "schema": "harmonia.module.ladder.v1",
  "id": "controller-streaming-config",
  "category": "known-good",
  "version": "1.0.0",
  "description": "HomeConsole operator-ruled controller and streaming configuration for Sunshine, uinput access, and RetroArch DualSense mappings.",
  "optional": false,
  "constants": {},
  "ladder": [
    {
      "step_id": "controller-streaming-user-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "home/steam/.config/sunshine/sunshine.conf",
          "home/steam/.config/retroarch/autoconfig/udev/Sony Interactive Entertainment DualSense Wireless Controller.cfg",
          "home/steam/.config/retroarch/autoconfig/udev/Sunshine PS5 (virtual) pad.cfg"
        ],
        "backup_existing": true,
        "owner": "steam",
        "group": "steam",
        "receipt_name": "homeconsole-controller-streaming-user-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "controller-streaming-system-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/udev/rules.d/60-sunshine.rules"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "homeconsole-controller-streaming-system-config"
      },
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
