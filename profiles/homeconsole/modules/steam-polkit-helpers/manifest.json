{
  "schema": "harmonia.module.ladder.v1",
  "id": "steam-polkit-helpers",
  "title": "Two staff-routed console helpers and one update refusal stub",
  "summary": "Routes the session-select and select-branch helpers to sbin staff; steamos-update remains an exit-7 Arcadia OS refusal stub pending the future harmonia --check lane.",
  "category": "known-good",
  "version": "1.0.0",
  "description": "The Ubuntu session-select and select-branch payloads exec the corresponding sbin console verbs with the original arguments. steamos-update remains the Arcadia OS refusal stub and exits 7 until the future harmonia --check lane. No elevation or sudoers grant is introduced.",
  "optional": false,
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "steam-update-helper-stub",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/update",
        "target_path": "/usr/bin/steamos-polkit-helpers/steamos-update",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "steam-select-branch-helper-stub",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/select-branch",
        "target_path": "/usr/bin/steamos-select-branch",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "steam-session-select-helper-stub",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/session-select",
        "target_path": "/usr/bin/steamos-session-select",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    }
  ]
}
