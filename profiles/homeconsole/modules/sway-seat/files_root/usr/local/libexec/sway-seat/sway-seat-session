#!/usr/bin/python3
import json
import os
import pwd
import stat
import sys
import tempfile
import time

OWNER = "owner"
SESSION_DIRECTORY = "sway-seat"
SESSION_FILE = "session.json"
WAYVNC_BINARY = "/usr/bin/wayvnc"
WAYVNC_CONFIG = "/home/owner/.config/wayvnc/config"
CUA_BINARY = "/usr/local/bin/cua-driver"
MAX_SESSION_BYTES = 4096


def emit(signal):
    sys.stderr.write(signal + "\n")
    return 1


def owner_identity():
    try:
        return pwd.getpwnam(OWNER)
    except KeyError:
        raise RuntimeError("owner-account-unavailable")


def runtime_path(owner):
    return "/run/user/" + str(owner.pw_uid)


def session_path(owner):
    return os.path.join(runtime_path(owner), SESSION_DIRECTORY, SESSION_FILE)


def safe_text(value):
    return isinstance(value, str) and bool(value) and not any(ord(ch) < 32 or ord(ch) == 127 for ch in value)


def validate_runtime(owner, path):
    expected = runtime_path(owner)
    if path != expected:
        raise RuntimeError("sway-session-runtime-directory-mismatch")
    metadata = os.stat(path, follow_symlinks=False)
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != owner.pw_uid or metadata.st_mode & 0o077:
        raise RuntimeError("sway-session-runtime-directory-custody-invalid")
    return expected


def validate_socket_path(runtime, value, signal):
    if not safe_text(value) or not os.path.isabs(value):
        raise RuntimeError(signal)
    try:
        if os.path.commonpath((runtime, value)) != runtime or value == runtime:
            raise RuntimeError(signal)
    except ValueError:
        raise RuntimeError(signal)
    return value


def session_directory(owner, create):
    runtime = runtime_path(owner)
    validate_runtime(owner, runtime)
    directory = os.path.join(runtime, SESSION_DIRECTORY)
    try:
        metadata = os.stat(directory, follow_symlinks=False)
    except FileNotFoundError:
        if not create:
            return directory
        os.mkdir(directory, 0o700)
        metadata = os.stat(directory, follow_symlinks=False)
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != owner.pw_uid or metadata.st_mode & 0o077:
        raise RuntimeError("sway-session-directory-custody-invalid")
    return directory


def read_session(owner):
    path = session_path(owner)
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0))
    except FileNotFoundError:
        return None
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != owner.pw_uid or metadata.st_mode & 0o777 != 0o600 or metadata.st_size > MAX_SESSION_BYTES:
            raise RuntimeError("sway-session-file-custody-invalid")
        chunks = []
        remaining = MAX_SESSION_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(remaining, 1024))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        if len(data) > MAX_SESSION_BYTES:
            raise RuntimeError("sway-session-file-size-invalid")
    finally:
        os.close(descriptor)
    try:
        value = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise RuntimeError("sway-session-file-invalid")
    if not isinstance(value, dict) or set(value) != {"runtime_dir", "wayland_display", "sway_socket"}:
        raise RuntimeError("sway-session-file-shape-invalid")
    runtime = validate_runtime(owner, value.get("runtime_dir"))
    display = value.get("wayland_display")
    if not safe_text(display):
        raise RuntimeError("sway-session-wayland-display-invalid")
    display_path = display if os.path.isabs(display) else os.path.join(runtime, display)
    display_path = validate_socket_path(runtime, display_path, "sway-session-wayland-socket-invalid")
    sway_socket = validate_socket_path(runtime, value.get("sway_socket"), "sway-session-ipc-socket-invalid")
    return {"runtime_dir": runtime, "wayland_display": display, "wayland_socket": display_path, "sway_socket": sway_socket}


def publish_session():
    started = time.monotonic()
    owner = owner_identity()
    if os.getuid() != owner.pw_uid:
        raise RuntimeError("sway-session-publisher-not-owner")
    runtime = validate_runtime(owner, os.environ.get("XDG_RUNTIME_DIR", ""))
    display = os.environ.get("WAYLAND_DISPLAY", "")
    sway_socket = os.environ.get("SWAYSOCK", "")
    if not safe_text(display):
        raise RuntimeError("sway-session-wayland-display-missing")
    display_path = display if os.path.isabs(display) else os.path.join(runtime, display)
    validate_socket_path(runtime, display_path, "sway-session-wayland-socket-invalid")
    validate_socket_path(runtime, sway_socket, "sway-session-ipc-socket-invalid")
    desired = {"runtime_dir": runtime, "wayland_display": display, "sway_socket": sway_socket}
    try:
        current = read_session(owner)
    except RuntimeError:
        current = None
    if current is not None and current["runtime_dir"] == runtime and current["wayland_display"] == display and current["sway_socket"] == sway_socket:
        return 0
    directory = session_directory(owner, True)
    descriptor, temporary = tempfile.mkstemp(prefix=".session-", dir=directory)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write((json.dumps(desired, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, session_path(owner))
        directory_descriptor = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    duration_ms = int((time.monotonic() - started) * 1000)
    sys.stdout.write("sway-seat session-environment changed duration_ms=" + str(duration_ms) + "\n")
    return 0


def clear_session():
    owner = owner_identity()
    path = session_path(owner)
    try:
        metadata = os.stat(path, follow_symlinks=False)
    except FileNotFoundError:
        return 0
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != owner.pw_uid:
        raise RuntimeError("sway-session-clear-custody-invalid")
    os.unlink(path)
    sys.stdout.write("sway-seat session-environment cleared\n")
    return 0


def wait_for_session(timeout_seconds):
    owner = owner_identity()
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        state = read_session(owner)
        if state is not None:
            try:
                display_stat = os.stat(state["wayland_socket"], follow_symlinks=False)
                sway_stat = os.stat(state["sway_socket"], follow_symlinks=False)
                if stat.S_ISSOCK(display_stat.st_mode) and stat.S_ISSOCK(sway_stat.st_mode):
                    return owner, state
            except FileNotFoundError:
                pass
        time.sleep(0.2)
    raise RuntimeError("sway-session-environment-unavailable")


def launch(executable, arguments, timeout_seconds):
    owner, state = wait_for_session(timeout_seconds)
    environment = {
        "HOME": owner.pw_dir,
        "USER": OWNER,
        "LOGNAME": OWNER,
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "XDG_RUNTIME_DIR": state["runtime_dir"],
        "WAYLAND_DISPLAY": state["wayland_display"],
        "SWAYSOCK": state["sway_socket"],
    }
    os.execve(executable, [executable] + arguments, environment)


def main():
    if len(sys.argv) < 2:
        return emit("sway-seat-helper-mode-missing")
    mode = sys.argv[1]
    try:
        if mode == "publish-session" and len(sys.argv) == 2:
            return publish_session()
        if mode == "clear-session" and len(sys.argv) == 2:
            return clear_session()
        if mode == "wayvnc" and len(sys.argv) == 2:
            launch(WAYVNC_BINARY, ["--config", WAYVNC_CONFIG], 60)
        if mode == "cua-driver":
            launch(CUA_BINARY, sys.argv[2:], 30)
        return emit("sway-seat-helper-mode-invalid")
    except (OSError, RuntimeError, ValueError) as error:
        return emit(str(error) if str(error) else "sway-seat-helper-failed")


if __name__ == "__main__":
    raise SystemExit(main())
