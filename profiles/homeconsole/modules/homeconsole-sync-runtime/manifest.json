{
  "schema": "harmonia.module.ladder.v1",
  "id": "homeconsole-sync-runtime",
  "version": "1.1.0",
  "description": "HomeConsole game-library directory-tree declaration: ensures the Games ROM/ISO directory tree that caduceus sync now converges into exists with correct ownership.",
  "constants": {},
  "ladder": [
    {
      "step_id": "homeconsole-games-library-directories",
      "tool": "files",
      "permutation": "managed-directories",
      "args": {
        "directories": [
          {"path": "/home/owner/Games/roms/gba", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/genesis", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/n64", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/nes", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/snes", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/gamecube", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/ps1", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/psp", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/roms/wii", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/isos/ps1", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/isos/ps2", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/isos/sega-cd", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/artwork", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/pc/dos", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/sync", "mode": 493, "owner": "owner", "group": "owner"},
          {"path": "/home/owner/Games/receipts", "mode": 493, "owner": "owner", "group": "owner"}
        ]
      }
    }
  ]
}
