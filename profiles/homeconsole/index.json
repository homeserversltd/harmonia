{
  "schema": "harmonia.profile.v1",
  "id": "homeconsole",
  "package_authorities": {
    "arch": {
      "os_family": "arch",
      "package_manager": "pacman"
    },
    "ubuntu": {
      "os_family": "ubuntu",
      "package_manager": "apt"
    }
  },
  "dotfile_pool": "homeconsole",
  "identity": "homeconsole",
  "categories_required": true,
