  "module_spine_entered": "profiles/homeconsole/modules",
  "modules": [
    "system-packages",
    "dot-files",
    "keyman-runtime",
    "rust-build-toolchain",
    "homeconsole-network",
    "arcadia-gui-runtime",
    "console-session",
    "local-ai-runtime",
    "homeconsole-update-runtime",
    "household-time",
    "install-caduceus",
    "sbin",
    "documentation",
    "sudoers",
    "sunshine",
    "retroarch-input",
    "grub-branding",
    "sway-seat",
    "cua-driver",
    "hermes-seat"
  ]
}
