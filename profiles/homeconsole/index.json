    "homeconsole-update-runtime",
    "household-time",
    "caduceus",
    "sbin",
    "documentation",
    "mkdocs",
    "sudoers",
    "sunshine",
    "retroarch-input",
    "gamescope-backports-pin",
    "grub-branding",
    "sway-seat",
    "cua-driver",
    "hermes-seat",
    "sway-seat-arch-config",
    "sway-seat-arch-wayvnc-config",
    "hermes-sway-config",
    "hermes-wayvnc-config",
    "hermes-sway-seat",
    "hermes-cua-driver-service",
    "hermes-gateway-service",
