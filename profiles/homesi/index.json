{
  "schema": "harmonia.profile.v1",
  "id": "homesi",
  "version": "1.2.10",
  "package_authority": {
    "os_family": "debian",
    "package_manager": "apt"
  },
  "dotfile_pool": "homesi",
  "identity": "homesi",
  "categories_required": true,
  "description": "HomeSuperintelligence: a Debian 13 household assistant with local models, appliance controls, documentation, two private model shelves, and an owner desktop streamed over Sunshine. Hermes has its own headless screen that starts when it needs one.",
  "module_spine_entered": "profiles/homesi/modules",
  "modules": [
    "system-packages",
    "root-profile",
    "dot-files",
    "keyman",
    "noesis",
    "homesi-update-runtime",
    "household-time",
    "caduceus",
    "udev",
    "sbin",
    "documentation",
    "mkdocs",
    "web-front",
    "woodpecker-agent",
    "sudoers",
    "grub-branding",
    "sway",
    "kitty",
    "waybar",
    "dunst",
    "chromium",
    "kde-look",
    "gtk-theme",
    "bluetooth-audio",
    "screenshot",
    "xdg-user-settings",
    "desktop-config-payload",
    "screen-supervisor",
    "hermes-seat",
    "hermes-agent",
    "hermes-gateway-service",
    "hermes-dashboard-service",
    "qdrant",
    "mem0",
    "model-shelf",
    "model-slots",
    "sunshine-homesi"
  ]
}
