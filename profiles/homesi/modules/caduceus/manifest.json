{
  "schema": "harmonia.module.ladder.v1",
  "id": "caduceus",
  "title": "Appliance controls",
  "summary": "Maintains the Caduceus service and its declared appliance configuration.",
  "category": "known-good",
  "config_deploy": "interactable",
  "version": "1.0.0",
  "description": "Temporary existing-profile release asset for this appliance; a dedicated asset replaces this stand-in at rung 3.",
  "ladder": [
    {
      "step_id": "caduceus-source-sync",
      "tool": "git-artifact",
      "permutation": "sync",
      "args": {
        "component": "caduceus",
        "path": "/opt/caduceus/source",
        "source_dir": "/opt/caduceus/source",
        "bearer": "owner"
      }
    },
    {
      "step_id": "caduceus-staff-module-path",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/bin/python3",
        "args": [
          "/usr/local/sbin/agathodaimon/cli.py",
          "python",
          "staff-path",
          "--apply"
        ],
        "skip_if_absent": "/usr/local/sbin/agathodaimon/cli.py",
        "observation": {
          "program": "/usr/bin/python3",
          "args": [
            "/usr/local/sbin/agathodaimon/cli.py",
            "python",
            "staff-path",
            "--check"
          ],
          "expected_exit_code": 0,
          "expected_stdout": "/usr/local/sbin"
        }
      }
    },
    {
      "step_id": "caduceus-service-runtime",
      "tool": "service-runtime",
      "permutation": "converge",
      "args": {
        "module_id": "caduceus",
        "component": "caduceus",
        "release_repo": "HOMESERVERSLTD/caduceus",
        "identity": "liveness-marker",
        "bearer": "owner",
        "source_dir": "/opt/caduceus/source",
        "install_bin": "/usr/local/bin/caduceus",
        "service": "caduceus.service",
        "binary_name": "caduceus",
        "op_prefix": "caduceus",
        "run_schema": "harmonia.caduceus.install.v1",
        "managed_files_schema": "harmonia.caduceus.managed_files.v1",
        "asset_name": "caduceus-homeconsole-x86_64",
        "sidecar_name": "caduceus-homeconsole-x86_64.sha256",
        "url": "http://127.0.0.1:8787/health",
        "managed_files": [
          {
            "path": "/var/lib/caduceus/venv/lib/python3.14/site-packages/caduceus-staff.pth",
            "mode": 420,
            "content": "/usr/local/sbin\n"
          },
          {
            "path": "/var/lib/caduceus/state.json",
            "mode": 420,
            "content": "{\n  \"schema\": \"caduceus.state.v1\",\n  \"services\": {\n    \"update\": {\n      \"timer\": \"harmonia.timer\"\n    }\n  }\n}\n"
          }
        ],
        "caduceus_profile_source": {
          "source": "profiles/homeconsole/index.yaml",
          "path": "/etc/caduceus/profile.yaml",
          "mode": 420,
          "append": ""
        }
      }
    }
  ]
}
