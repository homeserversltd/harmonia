{
  "schema": "harmonia.module.ladder.v1",
  "id": "model-shelf",
  "title": "Model shelves",
  "summary": "Keeps two private household shelves for models and incoming files.",
  "category": "known-good",
  "version": "1.0.1",
  "description": "Keep the born Samba configuration and LAN-only model-shelf nftables gate as owner-accepted Config targets; restart Samba and reload nftables only after this module changed in a press; birth owns packages, accounts, and directories.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "model-shelf-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/samba/smb.conf",
          "etc/nftables.conf"
        ],
        "owner": "root",
        "group": "root",
        "mode": 420,
        "backup_existing": false,
        "receipt_name": "model-shelf-config"
      }
    },
    {
      "step_id": "model-shelf-nftables-reload",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "systemctl",
        "args": [
          "reload",
          "nftables.service"
        ],
        "timeout_secs": 60,
        "observation": {
          "kind": "module_changed_before_step"
        }
      }
    },
    {
      "step_id": "model-shelf-restart",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "systemctl",
        "args": [
          "restart",
          "smbd.service"
        ],
        "timeout_secs": 60,
        "observation": {
          "kind": "module_changed_before_step"
        }
      }
    }
  ]
}
