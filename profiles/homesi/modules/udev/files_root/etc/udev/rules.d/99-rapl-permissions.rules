# Allow the caduceus group to read RAPL energy files for the power chip
# Caduceus runs as user caduceus on a HomeSI, so it reads without sudo
SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", ACTION=="add", RUN+="/bin/chgrp caduceus /sys/class/powercap/%k/energy_uj", RUN+="/bin/chmod g+r /sys/class/powercap/%k/energy_uj"
