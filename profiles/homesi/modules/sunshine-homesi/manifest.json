{
  "schema": "harmonia.module.ladder.v1",
  "id": "sunshine-homesi",
  "title": "Desktop streaming",
  "summary": "Keeps the owner desktop streaming configuration ready for the boot-selected seat.",
  "category": "known-good",
  "version": "1.2.0",
  "optional": false,
  "description": "Maintains the HomeSI owner session, streaming template and session wiring; birth and Caduceus own startup.",
  "constants": {},
  "ladder": [
    {
      "step_id": "sunshine-user-config",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/config",
        "target_path": "/home/owner/.config/sunshine/sunshine.conf",
        "mode": 420,
        "backup_existing": true,
        "owner": "owner",
        "group": "owner"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sunshine-device-access",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": ["etc/udev/rules.d/60-sunshine.rules", "usr/share/wayland-sessions/sway-owner-one-session.desktop"],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "homesi-sunshine-device-access"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sunshine-owner-template",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/unit",
        "target_path": "/home/owner/.config/systemd/user/sunshine@.service",
        "mode": 420,
        "backup_existing": true,
        "owner": "owner",
        "group": "owner"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "homesi-session-wiring",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/home/owner",
        "files": [".config/systemd/user/hometv-sway-session.target.d/10-homesi-services.conf", ".config/systemd/user/screen-supervisor.service"],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "owner-user-daemon-reload",
      "tool": "systemd",
      "permutation": "user-daemon-reload",
      "args": {"user": "owner", "timeout_secs": 60},
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
