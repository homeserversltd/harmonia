#!/bin/sh
set -eu
: "${XDG_RUNTIME_DIR:?missing hermes private runtime directory}"
: "${WAYLAND_DISPLAY:?missing hermes Wayland display}"
case "$WAYLAND_DISPLAY" in
    /*) wayland_socket=$WAYLAND_DISPLAY ;;
    *) wayland_socket=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ;;
esac
attempt=0
while [ "$attempt" -lt 60 ]; do
    if [ -S "$wayland_socket" ]; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done
printf '%s\n' 'hermes-sway-readiness-timeout' >&2
exit 1
