{
  "schema": "harmonia.module.ladder.v1",
  "id": "hermes-sway-config",
  "title": "Hermes Sway configuration",
  "summary": "Offers the headless Hermes Sway configuration.",
  "category": "interactable",
  "version": "1.0.0",
  "description": "Compile the Debian Sway configuration into the Hermes home as a Config proposal.",
  "optional": false,
  "config_deploy": "interactable",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "hermes-sway-config",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/config",
        "target_path": "/home/hermes/.config/sway/config",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    }
  ]
}
