{
  "schema": "harmonia.module.ladder.v1",
  "id": "jellyfin",
  "version": "1.1.0",
  "description": "Quarry-lifted HOMESERVER Jellyfin configuration: assert the birth-provided binary, converge the product-owned unit with backup, preserve user-editable system.xml, and restart only after this module changed managed material.",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "jellyfin-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/jellyfin.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "jellyfin-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "jellyfin-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "jellyfin-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "jellyfin.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "jellyfin-service-enable",
      "tool": "systemd",
      "permutation": "enable-now",
      "args": {
        "service": "jellyfin.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
