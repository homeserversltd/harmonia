{
  "schema": "harmonia.module.ladder.v1",
  "id": "vaultwarden",
  "version": "1.0.0",
  "description": "Quarry-lifted HOMESERVER Vaultwarden configuration: assert the birth-provided runtime, preserve the user-editable secret-bearing environment file, converge the product-owned unit with backup, validate it, and restart only after this module changed managed material.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "vaultwarden-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/vaultwarden.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "vaultwarden-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "vaultwarden-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "vaultwarden-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "vaultwarden.service",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    },
    {
      "step_id": "vaultwarden-service-enable",
      "tool": "systemd",
      "permutation": "enable-now",
      "args": {
        "service": "vaultwarden.service",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    }
  ]
}
