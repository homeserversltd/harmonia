{
  "schema": "harmonia.module.ladder.v1",
  "id": "tailscale",
  "category": "interactable",
  "version": "1.0.2",
  "description": "Quarry-lifted HOMESERVER Tailscale daemon configuration: assert the birth-provided binary, converge the product-owned daemon defaults with backup.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "tailscale-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/default/tailscaled"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tailscale-product-config"
      },
      "on_failure": "stop"
    }
  ]
}
