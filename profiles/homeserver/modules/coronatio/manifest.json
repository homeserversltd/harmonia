{
  "schema": "harmonia.module.ladder.v1",
  "id": "coronatio",
  "title": "Server dashboard",
  "summary": "Maintains the server's web dashboard and local settings.",
  "category": "known-good",
  "version": "2.2.0",
  "description": "HOMESERVER Coronatio configuration custody and native Forgejo Release runtime convergence.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "coronatio-service-runtime",
      "tool": "service-runtime",
      "permutation": "converge",
      "args": {
        "component": "coronatio",
        "release_repo": "HOMESERVERSLTD/coronatio",
        "source_dir": "/opt/coronatio/source",
        "install_bin": "/usr/local/bin/coronatio",
        "service": "coronatio.service",
        "url": "http://127.0.0.1:3013/health",
        "binary_name": "coronatio",
        "op_prefix": "coronatio",
        "run_schema": "harmonia.homeserver.install_coronatio.v1",
        "managed_files_schema": "harmonia.homeserver.coronatio_managed_files.v1",
        "bearer": "owner",
        "identity": "embedded-sha"
      },
      "on_failure": "stop"
    }
  ]
}
