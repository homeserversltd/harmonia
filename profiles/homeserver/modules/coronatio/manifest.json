{
  "schema": "harmonia.module.ladder.v1",
  "id": "coronatio",
  "version": "2.0.0",
  "description": "Quarry-lifted HOMESERVER crown configuration: assert the birth-provided Coronatio binary, preserve and validate the user-editable live household memory, converge the secret-free product factory baseline with backup, and validate the installed baseline without restarting the service.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "coronatio-binary-present",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "coronatio",
        "search_scope": "system",
        "receipt_label": "birth-provided Coronatio binary"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "coronatio-live-config-present",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/test",
        "args": ["-s", "/etc/homeserver.json"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "coronatio-live-config-valid",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/python3",
        "args": ["-m", "json.tool", "/etc/homeserver.json"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "coronatio-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/homeserver.factory"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "coronatio-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "coronatio-factory-config-valid",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/python3",
        "args": ["-m", "json.tool", "/etc/homeserver.factory"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
