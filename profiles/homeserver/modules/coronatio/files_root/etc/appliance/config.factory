{
    "tabs": {
      "admin": {
        "config": {
          "displayName": "Admin",
          "adminOnly": true,
          "order": 0,
          "isEnabled": true
        },
        "visibility": {
          "tab": true,
          "elements": {
            "settings": true
          }
        },
        "data": {
        }
      },

      "portals": {
        "config": {
          "displayName": "Portals",
          "adminOnly": false,
          "order": 1,
          "isEnabled": true
        },
        "visibility": {
          "tab": true,
          "elements": {
            "Jellyfin": true,
            "Transmission": true,
            "Piwigo": true,
            "MkDocs": true,
            "Vaultwarden": true,
            "Forgejo": true,
            "Navidrome": true,
            "FileBrowser": true,
            "Calibre Web": true,
            "FreshRSS": true,
            "TTYD": true
          }
        },
        "data": {
          "portals": [
            {
              "name": "Jellyfin",
              "description": "Media server",
              "services": ["jellyfin"],
              "type": "systemd",
              "port": 8096,
              "localURL": "https://jellyfin.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Transmission",
              "description": "BitTorrent client",
              "services": ["transmissionPIA"],
              "type": "systemd",
              "port": 9091,
              "localURL": "https://transmission.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Piwigo",
              "description": "Photo gallery",
              "services": ["php-fpm"],
              "type": "systemd",
              "port": 8080,
              "localURL": "https://photos.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "MkDocs",
              "description": "Documentation",
              "services": ["mkdocs"],
              "type": "systemd",
              "port": 8005,
              "localURL": "https://docs.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Vaultwarden",
              "description": "Password manager",
              "services": ["vaultwarden"],
              "type": "systemd",
              "port": 8200,
              "localURL": "https://vault.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Forgejo",
              "description": "Git service",
              "services": ["forgejo"],
              "type": "systemd",
              "port": 3000,
              "localURL": "https://git.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Navidrome",
              "description": "Music server",
              "services": ["navidrome"],
              "type": "systemd",
              "port": 4533,
              "localURL": "https://music.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "FileBrowser",
              "description": "File manager",
              "services": ["filebrowser"],
              "type": "systemd",
              "port": 8081,
              "localURL": "https://files.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Calibre Web",
              "description": "E-book manager",
              "services": ["calibre-web", "calibre-simple-watch"],
              "type": "systemd",
              "port": 8083,
              "localURL": "https://books.home.arpa",
              "remoteURL": ""
            },
            {
              "name": "Yarr",
              "description": "RSS reader",
              "services": ["yarr"],
              "type": "systemd",
              "port": 7070,
              "localURL": "https://rss.home.arpa",
              "remoteURL": ""
            }
          ]
        }
      },
      "upload": {
        "config": {
          "displayName": "Upload",
          "adminOnly": false,
          "order": 2,
          "isEnabled": true
        },
        "visibility": {
          "tab": true,
          "elements": {
            "tree": true,
            "buttons": true
          }
        },
        "data": {
          "blacklist": [],
          "default-directory": "/mnt/nas",
          "isPinRequired": true
        }
      },
      "stats": {
        "config": {
          "displayName": "Stats",
          "adminOnly": false,
          "order": 3,
          "isEnabled": true
        },
        "visibility": {
          "tab": true,
          "elements": {
            "cpu-chart": true,
            "network-chart": true,
            "disk-usage": true,
            "memory-usage": true,
            "process-list": true,
            "io-section": true,
            "kea-leases": true
          }
        },
        "data": {
        }
      },
      "starred": "portals"
    },
    "global": {
      "theme": {
        "name": "dark"
      },
      "admin": {
        "pin": ""
      },
      "cors": {
        "allowed_origins": [
          "https://home.arpa"
        ]
      },
      "mounts": {
        "vault": {
          "device": "homeserver-vault",
          "mountPoint": "/vault",
          "encrypted": true
        },
        "deploy": {
          "device": "homeserver-deploy",
          "mountPoint": "/deploy",
          "encrypted": true
        },
        "root": {
          "device": "homeserver-root",
          "mountPoint": "/",
          "encrypted": false
        },
        "boot": {
          "device": "homeserver-boot",
          "mountPoint": "/boot",
          "encrypted": false
        },
        "boot-efi": {
          "device": "homeserver-boot-efi",
          "mountPoint": "/boot/efi",
          "encrypted": false
        },
        "nas": {
          "device": "homeserver-primary-nas",
          "mountPoint": "/mnt/nas",
          "encrypted": true
        },
        "nas-backup": {
          "device": "homeserver-backup-nas",
          "mountPoint": "/mnt/nas_backup",
          "encrypted": true
        }
      },
      "ignoredMounts": ["/boot", "/boot/efi", "/vault", "udev"],
      "permissions": {
          "nas": {
              "basePath": "/mnt/nas",
              "applications": {
                  "Jellyfin": {
                      "user": "jellyfin",
                      "group": "jellyfin",
                      "permissions": "775",
                      "paths": [
                          "/mnt/nas/media"
                      ],
                      "recursive": true,
                      "includeIncludedPermissions": true
                  },
                  "Transmission": {
                      "user": "debian-transmission",
                      "group": "debian-transmission",
                      "permissions": "775",
                      "paths": [
                          "/mnt/nas/downloads",
                          "/mnt/nas/downloads/complete",
                          "/mnt/nas/downloads/incomplete",
                          "/mnt/nas/downloads/objectives"
                      ],
                      "recursive": true,
                      "includeIncludedPermissions": true
                  },
                  "CalibreWeb": {
                      "user": "calibre",
                      "group": "calibre",
                      "permissions": "775",
                      "paths": [
                          "/mnt/nas/books"
                      ],
                      "recursive": true,
                      "includeIncludedPermissions": true
                  },
                  "Navidrome": {
                      "user": "navidrome",
                      "group": "navidrome",
                      "permissions": "775",
                      "paths": [
                          "/mnt/nas/music"
                      ],
                      "recursive": true,
                      "includeIncludedPermissions": true
                  },
                  "Piwigo": {
                      "user": "piwigo",
                      "group": "piwigo",
                      "permissions": "777",
                      "paths": [
                          "/mnt/nas/photos"
                      ],
                      "recursive": true,
                      "includeIncludedPermissions": true
                  }
              },
              "includedPermissions": {
                  "user": ["www-data","owner"],
                  "group": ["www-data","owner"]
              }
          }
      }
    }
}