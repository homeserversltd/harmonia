{
  "schema": "harmonia.module.ladder.v1",
  "id": "household-time",
  "category": "known-good",
  "version": "2.1.2",
  "optional": false,
  "description": "Household time resolver and LAN NTP gateway: retain the household timezone fact, then serve synchronized NTP through chrony.",
  "caduceus_commands": [
    "time resolve",
    "time state"
  ],
  "ladder": [
    {
      "step_id": "household-time-resolve",
      "tool": "household-time",
      "permutation": "resolve",
      "args": {
        "backend": "caduceus",
        "timeout_secs": 15
      }
    },
    {
      "step_id": "household-time-chrony-lan-policy",
      "tool": "files",
      "permutation": "managed-files",
      "args": {},
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
