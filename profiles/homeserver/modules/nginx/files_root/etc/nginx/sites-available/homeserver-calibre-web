# Calibre-Web E-book Management Configuration
# Local access: https://books.home.arpa
# Tailscale access: https://[tailscale-ip]:18083 (8083 + 1 prefix = 18083)

# Local access server block
server {
    listen 443 ssl;
    server_name books.home.arpa;

    ssl_certificate /etc/ssl/home.arpa/cert.pem;
    ssl_certificate_key /etc/ssl/home.arpa/key.pem;
    include /etc/nginx/ssl_params.conf;

    location / {
        proxy_pass http://localhost:8083;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        # For book uploads
        client_max_body_size 1G;
        proxy_connect_timeout 600;
        proxy_send_timeout 600;
        proxy_read_timeout 600;
    }
}

# Tailscale direct access server block
server {
    listen *:18083 ssl;
    ssl_certificate /etc/ssl/home.arpa/cert.pem;
    ssl_certificate_key /etc/ssl/home.arpa/key.pem;

    # Disable SSL verification for self-signed cert
    ssl_verify_client off;

    location / {
        proxy_pass http://localhost:8083;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;

        # For book uploads
        client_max_body_size 1G;
        proxy_connect_timeout 600;
        proxy_send_timeout 600;
        proxy_read_timeout 600;
    }
}
