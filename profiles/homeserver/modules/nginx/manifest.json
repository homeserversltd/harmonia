{
  "schema": "harmonia.module.ladder.v1",
  "id": "nginx",
  "category": "interactable",
  "version": "1.1.0",
  "description": "Quarry-lifted HOMESERVER nginx configuration: assert the birth-provided binary, converge product-owned config with backups, enable declared sites through validated links, validate the whole configuration, and restart only after this module changed managed material.",
  "constants": {
    "sites": [
      "homeserver-calibre-web",
      "homeserver-filebrowser",
      "homeserver-forgejo",
      "homeserver-jellyfin",
      "homeserver-main",
      "homeserver-mkdocs",
      "homeserver-navidrome",
      "homeserver-piwigo",
      "homeserver-transmission",
      "homeserver-vaultwarden",
      "homeserver-yarr"
    ]
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "nginx-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/nginx/nginx.conf",
          "etc/nginx/ssl_params.conf",
          "etc/nginx/sites-available/homeserver-calibre-web",
          "etc/nginx/sites-available/homeserver-filebrowser",
          "etc/nginx/sites-available/homeserver-forgejo",
          "etc/nginx/sites-available/homeserver-jellyfin",
          "etc/nginx/sites-available/homeserver-main",
          "etc/nginx/sites-available/homeserver-mkdocs",
          "etc/nginx/sites-available/homeserver-navidrome",
          "etc/nginx/sites-available/homeserver-piwigo",
          "etc/nginx/sites-available/homeserver-transmission",
          "etc/nginx/sites-available/homeserver-vaultwarden",
          "etc/nginx/sites-available/homeserver-yarr",
          "etc/systemd/system/nginx.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "nginx-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-calibre-web",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-calibre-web",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-calibre-web",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-filebrowser",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-filebrowser",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-filebrowser",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-forgejo",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-forgejo",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-forgejo",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-jellyfin",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-jellyfin",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-jellyfin",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-main",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-main",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-main",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-mkdocs",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-mkdocs",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-mkdocs",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-navidrome",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-navidrome",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-navidrome",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-piwigo",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-piwigo",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-piwigo",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-transmission",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-transmission",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-transmission",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-vaultwarden",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-vaultwarden",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-vaultwarden",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "enable-homeserver-yarr",
      "tool": "files",
      "permutation": "validated-symlink",
      "args": {
        "source": "/etc/nginx/sites-available/homeserver-yarr",
        "category": "known-good",
        "target": "/etc/nginx/sites-enabled/homeserver-yarr",
        "validator_program": "/usr/sbin/nginx",
        "validator_args": ["-t"],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "nginx-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "nginx-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "nginx.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
