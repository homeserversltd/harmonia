{
  "schema": "harmonia.module.ladder.v1",
  "id": "yarr",
  "title": "Reading list",
  "summary": "Keeps the household's saved news feeds available in one place.",
  "category": "interactable",
  "version": "1.1.0",
  "description": "Keep the birth-provided Yarr binary current from a verified upstream release and maintain its product-owned service unit.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "yarr-binary-present",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/test",
        "args": [
          "-x",
          "/opt/yarr/yarr"
        ],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "yarr-release-binary",
      "tool": "release-binary",
      "permutation": "install",
      "args": {
        "component": "yarr",
        "asset": "yarr_linux_amd64.zip",
        "archive_member": "yarr",
        "service": "yarr.service",
        "path": "/opt/yarr/yarr",
        "mode": 493
      },
      "on_failure": "stop"
    },
    {
      "step_id": "yarr-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/yarr.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "yarr-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "yarr-unit-valid",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/systemd-analyze",
        "args": [
          "--root=/",
          "verify",
          "/etc/systemd/system/yarr.service"
        ],
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "yarr-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },

    {
      "step_id": "yarr-service-ready",
      "tool": "systemd",
      "permutation": "is-active-probe",
      "args": {
        "service": "yarr.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
