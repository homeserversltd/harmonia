{
  "schema": "harmonia.module.ladder.v1",
  "id": "transmission",
  "category": "interactable",
  "version": "1.0.2",
  "description": "Quarry-lifted HOMESERVER Transmission configuration: assert the birth-provided daemon and VPN launcher, preserve the secret-bearing settings seed, converge product-owned sysctl and namespace unit bytes with backups, validate the unit.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "transmission-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/sysctl.d/60-udpbuffer.conf",
          "etc/systemd/system/transmissionPIA.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "transmission-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "transmission-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
