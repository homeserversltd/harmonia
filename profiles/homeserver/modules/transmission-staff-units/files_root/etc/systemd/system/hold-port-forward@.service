[Unit]
Description=Hold the %i VPN provider open for Transmission
Wants=network-online.target
After=network-online.target vault.mount mnt-nas.mount transmissionPIA.service transmission-daemon.service
Conflicts=transmissionPIA.service transmission-daemon.service
ConditionPathIsMountPoint=/vault
ConditionPathIsMountPoint=/mnt/nas
Upholds=transmissionVPN.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
Environment=PYTHONDONTWRITEBYTECODE=1
StandardInput=data
StandardInputText={"provider":"%i"}
ExecStartPre=/usr/local/sbin/agathodaimon/cli.py transmission/vpn/namespace
ExecStart=/usr/local/sbin/agathodaimon/cli.py transmission/vpn/hold
Restart=on-failure
RestartSec=30
TimeoutStartSec=180
