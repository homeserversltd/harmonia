{
  "schema": "harmonia.module.ladder.v1",
  "id": "transmission-staff-units",
  "category": "known-good",
  "version": "1.0.0",
  "description": "Fixed HOMESERVER Transmission staff VPN control and daemon unit bytes.",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "transmission-staff-units-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/hold-port-forward@.service",
          "etc/systemd/system/transmission-vpn@.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "transmission-staff-units-config"
      },
      "on_failure": "stop"
    }
  ]
}
