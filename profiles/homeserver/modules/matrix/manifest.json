{
  "schema": "harmonia.module.ladder.v1",
  "id": "matrix",
  "category": "interactable",
  "version": "1.0.1",
  "description": "Matrix Synapse host server and Element Web chat portal: non-secret configuration, birth-preserved secrets, PostgreSQL declaration, loopback API, LAN/Tailscale web entry points, DNS, Caduceus-delegated portal registration, log rotation, and health proof.",
  "constants": {
    "server_name": "home.arpa",
    "synapse_loopback": "127.0.0.1:8008",
    "matrix_domain": "matrix.home.arpa",
    "element_domain": "chat.home.arpa",
    "element_alias_domain": "element.home.arpa",
    "portal_name": "element",
    "portal_local_url": "https://chat.home.arpa"
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "matrix-managed-files",
      "tool": "files",
      "permutation": "managed-files",
      "args": {}
    },
    {
      "step_id": "matrix-substrate-converge",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/bin/python3",
        "args": ["/usr/local/sbin/agathodaimon/cli.py", "matrix", "matrix-converge"],
        "timeout_secs": 1800
      }
    },
    {
      "step_id": "matrix-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {}
    }
  ]
}
