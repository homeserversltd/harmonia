#!/bin/sh
set -eu

assert_dpkg_package() {
    package="$1"
    if ! dpkg -s "$package" >/dev/null 2>&1; then
        echo "matrix-floor-missing:${package} (born-incomplete — floor belongs to the deployables birth module)" >&2
        exit 1
    fi
}

assert_floor_file() {
    path="$1"
    signal="$2"
    if [ ! -f "$path" ]; then
        echo "matrix-floor-missing:${signal} (born-incomplete — floor belongs to the deployables birth module)" >&2
        exit 1
    fi
}

material_fingerprint() {
    for path in "$@"; do
        if [ -L "$path" ]; then
            printf 'link %s %s\n' "$path" "$(readlink "$path")"
        elif [ -f "$path" ]; then
            sha256sum "$path"
        else
            printf 'absent %s\n' "$path"
        fi
    done | sha256sum | cut -d' ' -f1
}

reload_when_material_changed() {
    name="$1"
    service="$2"
    state_file="/var/lib/harmonia/state/matrix-${name}-material.sha256"
    shift 2
    current="$(material_fingerprint "$@")"
    previous="$(cat "$state_file" 2>/dev/null || true)"
    if [ "$current" = "$previous" ]; then
        printf '%s\n' "${service}: converged-quiet"
        return 0
    fi
    if systemctl is-active --quiet "$service"; then
        systemctl reload "$service"
    fi
    install -d -o root -g root -m 0755 /var/lib/harmonia/state
    tmp="${state_file}.new.$$"
    printf '%s\n' "$current" >"$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$state_file"
}

for package in matrix-synapse-py3 nginx postgresql-client logrotate openssl unbound ca-certificates curl tar python3; do
    assert_dpkg_package "$package"
done
assert_floor_file /usr/share/element-web/index.html element-web-index
assert_floor_file /usr/share/element-web/.artifact-sha256 element-web-artifact-sha256

getent group matrix-synapse >/dev/null 2>&1 || groupadd --system matrix-synapse
id -u matrix-synapse >/dev/null 2>&1 || useradd --system --gid matrix-synapse --home-dir /var/lib/matrix-synapse --shell /usr/sbin/nologin matrix-synapse

install -d -o root -g matrix-synapse -m 0750 /etc/matrix-synapse /etc/matrix-synapse/conf.d
install -d -o matrix-synapse -g matrix-synapse -m 0750 /var/lib/matrix-synapse /var/lib/matrix-synapse/media
install -d -o matrix-synapse -g adm -m 0750 /var/log/matrix-synapse
install -d -o root -g root -m 0755 /usr/share/harmonia/matrix

# Birth-owned values are generated once. Harmonia owns only presence, owner, and mode;
# it never renders or replaces this file.
secrets=/etc/matrix-synapse/conf.d/90-birth-secrets.yaml
if [ ! -e "$secrets" ]; then
    umask 077
    macaroon_secret_key="$(openssl rand -hex 32)"
    form_secret="$(openssl rand -hex 32)"
    registration_shared_secret="$(openssl rand -hex 32)"
    tmp="${secrets}.new.$$"
    {
        printf 'macaroon_secret_key: "%s"\n' "$macaroon_secret_key"
        printf 'form_secret: "%s"\n' "$form_secret"
        printf 'registration_shared_secret: "%s"\n' "$registration_shared_secret"
    } >"$tmp"
    chown root:matrix-synapse "$tmp"
    chmod 0640 "$tmp"
    mv "$tmp" "$secrets"
fi
chown root:matrix-synapse "$secrets"
chmod 0640 "$secrets"

chown root:matrix-synapse /etc/matrix-synapse/homeserver.yaml /etc/matrix-synapse/log.yaml
chmod 0640 /etc/matrix-synapse/homeserver.yaml /etc/matrix-synapse/log.yaml

ensure_postgres_peer_admission() {
    desired='local   synapse         matrix-synapse                          peer'
    changed=0
    found=0
    for hba in /etc/postgresql/*/main/pg_hba.conf; do
        [ -f "$hba" ] || continue
        found=1
        if grep -Fqx "$desired" "$hba"; then
            continue
        fi
        tmp="${hba}.harmonia-matrix-new.$$"
        awk -v desired="$desired" '
            $1 == "local" && $2 == "all" && $3 == "all" && $4 == "scram-sha-256" && !inserted {
                print desired
                inserted = 1
            }
            { print }
            END {
                if (!inserted) {
                    print desired
                }
            }
        ' "$hba" >"$tmp"
        chown --reference="$hba" "$tmp"
        chmod --reference="$hba" "$tmp"
        mv "$tmp" "$hba"
        changed=1
    done
    if [ "$found" -eq 0 ]; then
        echo "matrix-postgresql-pg-hba-missing" >&2
        return 1
    fi
    if [ "$changed" -eq 1 ]; then
        runuser -u postgres -- psql --set=ON_ERROR_STOP=1 --command='SELECT pg_reload_conf();' postgres >/dev/null
    fi
}

ensure_unbound_conf_d_include() {
    conf=/etc/unbound/unbound.conf
    include='include-toplevel: "/etc/unbound/unbound.conf.d/*.conf"'
    [ -f "$conf" ] || return 0
    if grep -Fqx "$include" "$conf"; then
        return 0
    fi
    printf '\n%s\n' "$include" >>"$conf"
}

# psql's \gexec declarations create missing objects and converge role attributes;
# peer authentication means no database password is required or stored.
runuser -u postgres -- psql --set=ON_ERROR_STOP=1 --file=/usr/share/harmonia/matrix/postgres.sql postgres
ensure_postgres_peer_admission
ensure_unbound_conf_d_include

ln -sfn /etc/nginx/sites-available/homeserver-matrix /etc/nginx/sites-enabled/homeserver-matrix
ln -sfn /etc/nginx/sites-available/homeserver-element /etc/nginx/sites-enabled/homeserver-element

# Caduceus is the sole configuration writer. The logical path keeps this
# concern profile-agnostic while Caduceus preserves the household document.
if ! curl --fail --silent --show-error --max-time 10 \
    --request POST http://127.0.0.1:3014/api/v1/config/set \
    --header 'Content-Type: application/json' \
    --data-binary @- <<'JSON'
{"path":"tabs.portals","value":{"visibility":{"tab":true,"elements":{"Element":true}},"data":{"portals":[{"name":"Element","description":"Private chat for your homeserver.","services":["matrix-synapse"],"type":"systemd","port":8008,"localURL":"https://chat.home.arpa"}]}}}
JSON
then
    echo 'first_missing_signal=caduceus-config-unreachable' >&2
    exit 1
fi

nginx -t
unbound-checkconf
logrotate --debug /etc/logrotate.d/matrix-synapse >/dev/null

reload_when_material_changed nginx nginx.service \
    /etc/nginx/sites-available/homeserver-matrix \
    /etc/nginx/sites-available/homeserver-element \
    /etc/nginx/sites-enabled/homeserver-matrix \
    /etc/nginx/sites-enabled/homeserver-element
reload_when_material_changed unbound unbound.service \
    /etc/unbound/unbound.conf \
    /etc/unbound/unbound.conf.d/matrix.conf
