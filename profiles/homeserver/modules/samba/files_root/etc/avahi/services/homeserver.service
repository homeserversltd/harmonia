<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name>home.arpa</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
    <host-name>home</host-name>
  </service>
  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=HomeServer</txt-record>
  </service>
</service-group>
