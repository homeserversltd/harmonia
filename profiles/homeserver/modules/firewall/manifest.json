{
  "schema": "harmonia.module.ladder.v1",
  "id": "firewall",
  "version": "1.1.0",
  "description": "Quarry-lifted HOMESERVER network spine: assert birth-provided executables and host-owned network inputs, converge product-owned firewall/DNS/unit policy with backups, validate service configurations, and restart only after this module changed managed material.",
  "caduceus_commands": [
    "caduceus.network.firewall.read",
    "caduceus.network.firewall.put",
    "caduceus.network.firewall.delete"
  ],
  "constants": {
    "user_editable_files": [
      "/etc/systemd/network/10-wan0.network",
      "/etc/systemd/network/20-lan0.network",
      "/etc/kea/kea-dhcp4.conf",
      "/etc/nftables.d/caduceus-child-filter.nft"
    ]
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "firewall-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/default/unbound",
          "etc/nftables.conf",
          "etc/sysctl.d/70-homeserver-ipforward.conf",
          "etc/systemd/system/kea-dhcp4-server.service.d/override.conf",
          "etc/systemd/system/nftables.service",
          "etc/unbound/unbound.conf"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "firewall-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "caduceus-child-filter-seed-present",
      "tool": "files",
      "permutation": "ensure-present",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/nftables.d/caduceus-child-filter.nft"
        ],
        "owner": "root",
        "group": "root",
        "receipt_name": "caduceus-child-filter-seed"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "firewall-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "nftables-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "nftables.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "unbound-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "unbound.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "kea-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "kea-dhcp4-server.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
