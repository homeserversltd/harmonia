# Caduceus disk-doors policy: fixed actuator entry points with device-scoped destructive operations.
caduceus ALL=(root) NOPASSWD: /usr/sbin/wipefs -a /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/sbin/wipefs -a /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/sbin/wipefs -a /dev/mmcblk*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -o /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -o /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -o /dev/mmcblk*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -n 1\:0\:0 /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -n 1\:0\:0 /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -n 1\:0\:0 /dev/mmcblk*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -t 1\:8300 /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -t 1\:8300 /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -t 1\:8300 /dev/mmcblk*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -c * /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -c * /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/sbin/sgdisk -c * /dev/mmcblk*
caduceus ALL=(root) NOPASSWD: /usr/sbin/udevadm trigger --subsystem-match=block --action=change
caduceus ALL=(root) NOPASSWD: /usr/bin/findmnt -n -o SOURCE\,TARGET --target /mnt/*
caduceus ALL=(root) NOPASSWD: /usr/bin/test -b /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/bin/test -b /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/bin/test -b /dev/mmcblk*
caduceus ALL=(root) NOPASSWD: /usr/bin/test -e /dev/mapper/*
caduceus ALL=(root) NOPASSWD: /usr/sbin/mkfs.xfs -f /dev/sd*
caduceus ALL=(root) NOPASSWD: /usr/sbin/mkfs.xfs -f /dev/nvme*
caduceus ALL=(root) NOPASSWD: /usr/sbin/mkfs.xfs -f /dev/mapper/*
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup open /dev/sd* *
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup open /dev/nvme* *
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup open /dev/mmcblk* *
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup open --key-file - /dev/sd* *
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup open --key-file - /dev/nvme* *
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup open --key-file - /dev/mmcblk* *
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup luksFormat --type luks2 --key-file - /dev/sd* -q --batch-mode
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup luksFormat --type luks2 --key-file - /dev/nvme* -q --batch-mode
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup luksFormat --type luks2 --key-file - /dev/mmcblk* -q --batch-mode
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup close *
caduceus ALL=(root) NOPASSWD: /usr/bin/bash /vault/scripts/exportNAS.sh
caduceus ALL=(root) NOPASSWD: /usr/bin/bash /vault/scripts/mountDrive.sh *
caduceus ALL=(root) NOPASSWD: /usr/bin/bash /vault/scripts/unmountDrive.sh *
caduceus ALL=(root) NOPASSWD: /usr/bin/bash /usr/local/sbin/setupNAS.sh *
caduceus ALL=(root) NOPASSWD: /usr/bin/du -sx --bytes /mnt/*
caduceus ALL=(root) NOPASSWD: /usr/bin/mkdir -p /mnt/*
caduceus ALL=(root) NOPASSWD: /usr/bin/chown -R * /mnt/*
caduceus ALL=(root) NOPASSWD: /usr/bin/rsync -a /mnt/* /mnt/*
