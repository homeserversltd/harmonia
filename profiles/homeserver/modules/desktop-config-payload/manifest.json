{
  "schema": "harmonia.module.ladder.v1",
  "id": "desktop-config-payload",
  "category": "interactable",
  "version": "1.0.0",
  "description": "Homeserver shell configuration payload. Harmonia converges the canonical Debian backend-server dotfiles into the owner home without installing software or managing services.",
  "optional": false,
  "constants": {
    "source_dir": "files_root",
    "target_dir": "/home/owner",
    "expected_files": [
      ".aliases",
      ".bash-preexec.sh",
      ".bashrc",
      ".enhanced_less_config",
      ".functions",
      ".gitconfig",
      ".inputrc",
      ".lesskey",
      ".nanorc",
      ".profile",
      ".tmux.conf",
      ".zshrc"
    ],
    "file_locality": "module-owned shell-rc intent folder",
    "intent_folders": [
      "shell-rc"
    ],
    "phase": 5,
    "receipt_schema": "harmonia.homeserver.desktop_config_payload.v1",
    "meaning": "The homeserver dotfile pool is converged from the module files_root into the owner home"
  },
  "ladder": [
    {
      "step_id": "files-shell-rc",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/shell-rc",
        "target_root": "$constants.target_dir",
        "files": [
          ".aliases",
          ".bash-preexec.sh",
          ".bashrc",
          ".enhanced_less_config",
          ".functions",
          ".gitconfig",
          ".inputrc",
          ".lesskey",
          ".nanorc",
          ".profile",
          ".tmux.conf",
          ".zshrc"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "homeserver-desktop-config-shell-rc",
        "summary_receipt": {
          "name": "homeserver-desktop-config-shell-rc-summary",
          "schema": "harmonia.homeserver.desktop_config_install.v1",
          "authority": "harmonia-profile-module-owned-files",
          "first_missing_signal": "homeserver-desktop-config-files-incomplete"
        }
      }
    }
  ],
  "files_root": "files_root"
}
