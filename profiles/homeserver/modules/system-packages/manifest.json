{
  "schema": "harmonia.module.ladder.v1",
  "id": "system-packages",
  "title": "Software updates",
  "summary": "Keeps this device's installed software current.",
  "category": "known-good",
  "version": "1.2.0",
  "isolation": "per-step",
  "description": "homeserver system package upgrade ladder using the package tool.",
  "optional": false,
  "constants": {},
  "ladder": [
    {
      "step_id": "system-packages-upgrade",
      "tool": "package",
      "permutation": "upgrade",
      "args": {},
      "on_failure": "stop"
    },
    {
      "step_id": "system-packages-restart-postgresql",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "postgresql.service",
        "timeout_secs": 120,
        "upgrade_step": "system-packages-upgrade",
        "upgraded_packages": ["^postgresql-[0-9]+$"]
      },
      "on_failure": "stop"
    }
  ]
}
