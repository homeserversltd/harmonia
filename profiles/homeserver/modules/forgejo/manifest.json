{
  "schema": "harmonia.module.ladder.v1",
  "id": "forgejo",
  "title": "Code hosting",
  "summary": "Keeps the household's private code projects available on the server.",
  "category": "interactable",
  "version": "1.1.3",
  "description": "Quarry-lifted HOMESERVER Forgejo configuration: assert the birth-provided binary and birth-owned app configuration, converge the product-owned unit with backup, validate it.",
  "group": {
    "group_id": "git-host",
    "group_order": 1,
    "live_probe": {
      "tool": "systemd",
      "permutation": "is-active-probe",
      "args": {
        "service": "forgejo.service"
      }
    }
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "forgejo-sshd-safe-metadata",
      "tool": "files",
      "permutation": "metadata",
      "args": {
        "files": [
          {"path":"/opt/forgejo", "owner":"root", "group":"root", "mode":493},
          {"path":"/opt/forgejo/forgejo", "owner":"root", "group":"root", "mode":493}
        ]
      },
      "on_failure": "stop"
    },
    {
      "step_id": "forgejo-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/forgejo.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "forgejo-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "forgejo-unit-valid",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/bin/systemd-analyze",
        "args": ["verify", "/etc/systemd/system/forgejo.service"],
        "timeout_secs": 30,
        "observation": {"kind": "module_changed_before_step"}
      },
      "on_failure": "stop"
    },
    {
      "step_id": "forgejo-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
