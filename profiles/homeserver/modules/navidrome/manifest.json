{
  "schema": "harmonia.module.ladder.v1",
  "id": "navidrome",
  "title": "Music library",
  "summary": "Keeps the household music library available while preserving personal settings.",
  "category": "interactable",
  "version": "1.0.4",
  "description": "Quarry-lifted HOMESERVER Navidrome configuration: assert the birth-provided runtime, preserve the user-editable secret-bearing configuration seed, converge the product-owned unit with backup, validate it.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "navidrome-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/navidrome.service",
          "etc/nginx/conf.d/agathodaimon-music-home-arpa.conf"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "navidrome-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "navidrome-unit-valid",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/bin/systemd-analyze",
        "args": [
          "--root=/",
          "verify",
          "/etc/systemd/system/navidrome.service"
        ],
        "timeout_secs": 30,
        "observation": {"kind": "module_changed_before_step"}
      },
      "on_failure": "stop"
    },
    {
      "step_id": "navidrome-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
