{
  "schema": "harmonia.module.ladder.v1",
  "id": "systemd",
  "category": "known-good",
  "version": "1.0.3",
  "description": "Quarry-lifted residual HOMESERVER systemd wiring: converge the product-owned vault.mount unit with backups, validate it.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "systemd-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/vault.mount"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "systemd-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "systemd-daemon-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
