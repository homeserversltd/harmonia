{
  "schema": "harmonia.module.ladder.v1",
  "id": "udev",
  "category": "known-good",
  "version": "1.0.1",
  "description": "Quarry-lifted HOMESERVER udev configuration: assert the birth-provided udev administrator, converge the product-owned static rule with backups, validate it.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "udev-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/udev/rules.d/99-rapl-permissions.rules"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "udev-product-config"
      },
      "on_failure": "stop"
    }
  ]
}
