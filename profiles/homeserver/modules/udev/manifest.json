{
  "schema": "harmonia.module.ladder.v1",
  "id": "udev",
  "category": "Owned",
  "version": "1.0.0",
  "description": "Quarry-lifted HOMESERVER udev configuration: assert the birth-provided udev administrator, converge the product-owned static rule with backups, validate it, and reload and trigger udev only after this module changed the managed rule.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "udev-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/udev/rules.d/99-rapl-permissions.rules"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "udev-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "udev-rules-reload-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "systemd-udevd.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "udev-trigger-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "systemd-udev-trigger.service",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    }
  ]
}
