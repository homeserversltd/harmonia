# Allow www-data group to read RAPL energy files for power monitoring
# This enables the homeserver power monitoring to work without sudo
SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", ACTION=="add", RUN+="/bin/chgrp www-data /sys/class/powercap/%k/energy_uj", RUN+="/bin/chmod g+r /sys/class/powercap/%k/energy_uj" 