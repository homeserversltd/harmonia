{
  "schema": "harmonia.module.ladder.v1",
  "id": "filebrowser",
  "category": "Presented",
  "version": "1.0.1",
  "description": "Quarry-lifted HOMESERVER File Browser service configuration: assert the birth-provided binary, converge the product-owned unit with backup, preserve the instance database, and restart only after this module changed managed material.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "filebrowser-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/systemd/system/filebrowser.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "filebrowser-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "filebrowser-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "filebrowser-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "filebrowser.service",
        "timeout_secs": 30
      },
      "on_failure": "stop"
    }
  ]
}
