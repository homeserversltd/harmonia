{
  "schema": "harmonia.module.ladder.v1",
  "id": "postgres",
  "category": "interactable",
  "version": "1.0.1",
  "description": "Quarry-lifted HOMESERVER PostgreSQL configuration: assert the birth-provided binary, converge product-owned configuration and unit bytes with backups, preserve the one-unit design, validate the installed configuration, and restart only after this module changed managed material.",
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "postgres-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "opt/homeserver/postgresql/current/pg_hba.conf",
          "opt/homeserver/postgresql/current/postgresql.conf",
          "opt/homeserver/postgresql/current/conf.d/ramdisk.conf",
          "opt/homeserver/postgresql/current/conf.d/tuning.conf",
          "etc/systemd/system/postgresql.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "postgres-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "postgres-distro-instance-mask",
      "tool": "systemd",
      "permutation": "mask",
      "args": {
        "service": "postgresql@.service",
        "timeout_secs": 60
      },
      "on_failure": "stop"
    },
    {
      "step_id": "postgres-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "postgres-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "postgresql.service",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    }
  ]
}
