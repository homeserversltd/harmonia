{
  "schema": "harmonia.module.ladder.v1",
  "id": "linker",
  "version": "1.0.0",
  "description": "Synchronize the canonical Linker Python source and self-clobber its complete live hardlink-management shelf.",
  "constants": {},
  "ladder": [
    {
      "step_id": "linker-source-sync",
      "tool": "git-artifact",
      "permutation": "sync",
      "args": {
        "component": "linker",
        "bearer": "owner",
        "path": "/opt/linker/source",
        "source_dir": "/opt/linker/source"
      }
    },
    {
      "step_id": "linker-source-shelf-sweep",
      "tool": "files",
      "permutation": "source-shelf-sweep",
      "args": {
        "source_root": "/opt/linker/source",
        "shelf_source": ".",
        "target_shelf": "/usr/local/lib/linker",
        "launcher_source_root": "/opt/linker/source",
        "launcher_target_root": "/usr/local/lib/linker",
        "launcher_pattern": "linker",
        "launcher_exclude": [
          ".git",
          "venv"
        ],
        "shelf_owner": "root",
        "shelf_group": "root",
        "shelf_directory_mode": 493,
        "shelf_file_mode": 493,
        "launcher_mode": 493,
        "prune": true
      }
    }
  ]
}
