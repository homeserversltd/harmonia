{
  "schema": "harmonia.module.ladder.v1",
  "id": "mkdocs",
  "version": "1.0.0",
  "description": "Quarry-lifted HOMESERVER MkDocs configuration: assert the birth-provided runtime and documentation source, converge product-owned configuration and unit bytes with backups, validate the unit, and restart only after this module changed managed material.",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "mkdocs-product-config",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "opt/docs/mkdocs.yml",
          "etc/systemd/system/mkdocs.service"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "mkdocs-product-config"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "mkdocs-systemd-reload",
      "tool": "systemd",
      "permutation": "daemon-reload",
      "args": {
        "timeout_secs": 30
      },
      "on_failure": "stop"
    },
    {
      "step_id": "mkdocs-restart-on-change",
      "tool": "systemd",
      "permutation": "restart",
      "args": {
        "service": "mkdocs.service",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    },
    {
      "step_id": "mkdocs-service-enable",
      "tool": "systemd",
      "permutation": "enable-now",
      "args": {
        "service": "mkdocs.service",
        "timeout_secs": 120
      },
      "on_failure": "stop"
    }
  ]
}
