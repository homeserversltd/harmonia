{
  "schema": "harmonia.module.ladder.v1",
  "id": "xdg-user-settings",
  "category": "interactable",
  "version": "1.0.0",
  "description": "TV KDE/application associations and portal configuration are converged from this module into the owner home.",
  "optional": false,
  "constants": {
    "target_dir": "/home/owner",
    "expected_files": [
      ".config/kde-mimeapps.list",
      ".config/kdeglobals",
      ".config/mimeapps.list",
      ".config/xdg-desktop-portal/hyprland-portals.conf",
      ".local/share/applications/mimeapps.list",
      ".local/share/applications/org.kde.kate.desktop"
    ],
    "phase": 5,
    "receipt_schema": "harmonia.tv.xdg_user_settings.v1",
    "meaning": "TV KDE/application associations and portal configuration are converged from this module into the owner home."
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "kde-and-associations",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/kde-applications",
        "target_root": "$constants.target_dir",
        "files": [
          ".config/kde-mimeapps.list",
          ".config/kdeglobals",
          ".config/mimeapps.list",
          ".local/share/applications/mimeapps.list",
          ".local/share/applications/org.kde.kate.desktop"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tv-xdg-user-settings-kde"
      }
    },
    {
      "step_id": "portal",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/portal",
        "target_root": "$constants.target_dir",
        "files": [
          ".config/xdg-desktop-portal/hyprland-portals.conf"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tv-xdg-user-settings-portal"
      }
    }
  ]
}
