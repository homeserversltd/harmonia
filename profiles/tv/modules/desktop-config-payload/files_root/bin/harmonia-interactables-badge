#!/usr/bin/env bash
set -u

readonly FEED_PATH="/var/lib/harmonia/interactables.json"

if ! rendered="$(HARMONIA_FEED_PATH="$FEED_PATH" python3 - <<'PY'
import json
import os
from pathlib import Path

try:
    payload = json.loads(Path(os.environ["HARMONIA_FEED_PATH"]).read_text(encoding="utf-8"))
    rows = payload.get("interactables", []) if isinstance(payload, dict) else []
    if not isinstance(rows, list):
        raise ValueError("interactables is not a list")
    count = sum(1 for row in rows if isinstance(row, dict))
    names = [str(row.get("name") or row.get("id") or "unnamed update") for row in rows if isinstance(row, dict)]
    tooltip = "Harmonia: no pending updates" if not names else "Harmonia pending updates:\n" + "\n".join(f"• {name}" for name in names[:5])
    print(json.dumps({
        "text": "󰚰" if not count else f"󰚰 {count}",
        "class": "ok" if not count else "pending",
        "tooltip": tooltip,
    }, ensure_ascii=False, separators=(",", ":")))
except (OSError, ValueError, json.JSONDecodeError) as error:
    print(json.dumps({"text": "󰚰", "class": "ok", "tooltip": f"Harmonia updates unavailable: {error}"}, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    printf '%s\n' '{"text":"󰚰","class":"ok","tooltip":"Harmonia updates unavailable"}'
    exit 0
fi

printf '%s\n' "$rendered"
