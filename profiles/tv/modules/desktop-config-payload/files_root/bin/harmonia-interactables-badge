#!/usr/bin/env bash
set -u

readonly FEED_PATH="${HARMONIA_FEED_PATH:-/var/lib/harmonia/interactables.json}"
readonly RECEIPT_DIR="${HARMONIA_RECEIPT_DIR:-/var/lib/harmonia/receipts/tv-update-latest}"
readonly SUBSCRIPTION_PATH="${HARMONIA_SUBSCRIPTION_PATH:-/var/lib/harmonia/subscription.json}"
readonly BADGE_STATE_CSS="${HARMONIA_BADGE_STATE_CSS:-${HOME}/.config/waybar/badge-state.css}"

if ! rendered="$(HARMONIA_FEED_PATH="$FEED_PATH" HARMONIA_RECEIPT_DIR="$RECEIPT_DIR" HARMONIA_SUBSCRIPTION_PATH="$SUBSCRIPTION_PATH" HARMONIA_BADGE_STATE_CSS="$BADGE_STATE_CSS" python3 - <<'PY'
import json
import os
import tempfile
from pathlib import Path

ICON = "󰚰"


def load_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, json.JSONDecodeError):
        return None


def item_name(value, fallback):
    if not isinstance(value, dict):
        return fallback
    return str(value.get("description") or value.get("name") or value.get("hotfix_id") or value.get("id") or fallback)


def converge_badge_css(path):
    declared = """#custom-harmonia-interactables.good {
    color: #a3be8c;
}

#custom-harmonia-interactables.medium {
    color: #ebcb8b;
}

#custom-harmonia-interactables.bad {
    color: #bf616a;
}
"""
    try:
        if path.read_text(encoding="utf-8") == declared:
            return
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(declared)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


feed_path = Path(os.environ["HARMONIA_FEED_PATH"])
receipt_dir = Path(os.environ["HARMONIA_RECEIPT_DIR"])
subscription_path = Path(os.environ["HARMONIA_SUBSCRIPTION_PATH"])
converge_badge_css(Path(os.environ["HARMONIA_BADGE_STATE_CSS"]))

feed = load_json(feed_path)
rows = feed.get("interactables", []) if isinstance(feed, dict) else []
pending = [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []
pending_names = [item_name(row, "unnamed update") for row in pending]

subscription = load_json(subscription_path)
hotfix_ledger = subscription.get("hotfix_ledger", {}) if isinstance(subscription, dict) else {}
hotfix_ledger = hotfix_ledger if isinstance(hotfix_ledger, dict) else {}
hotfixes = []
for path in sorted(receipt_dir.joinpath("hotfixes").glob("*.json")) if receipt_dir.joinpath("hotfixes").is_dir() else []:
    receipt = load_json(path)
    if not isinstance(receipt, dict):
        continue
    hotfix_id = str(receipt.get("hotfix_id") or path.stem)
    unresolved = receipt.get("lifecycle") == "blocked" or (
        receipt.get("eligibility_comparison") == "nonempty" and hotfix_id not in hotfix_ledger
    )
    if unresolved:
        hotfixes.append(item_name(receipt, hotfix_id))

ledger_path = receipt_dir.parent / "tv-ledger.jsonl"
entries = []
try:
    for line in ledger_path.read_text(encoding="utf-8").splitlines():
        value = json.loads(line)
        if isinstance(value, dict) and isinstance(value.get("run_id"), str):
            entries.append(value)
except (OSError, ValueError, json.JSONDecodeError):
    pass
latest_run_id = entries[-1]["run_id"] if entries else None
failed_modules = [
    str(entry.get("module_id") or "unnamed module")
    for entry in entries
    if entry.get("run_id") == latest_run_id and entry.get("ok") is False
]

if hotfixes:
    state = "bad"
    tooltip = "Harmonia hotfix needs attention:\n" + "\n".join(f"• {name}" for name in hotfixes)
elif failed_modules:
    state = "bad"
    tooltip = "Harmonia module failed:\n" + "\n".join(f"• {name}" for name in failed_modules)
elif pending_names:
    state = "medium"
    tooltip = "Harmonia pending updates:\n" + "\n".join(f"• {name}" for name in pending_names)
else:
    state = "good"
    tooltip = "Harmonia: no pending updates"

print(json.dumps({"text": ICON, "class": state, "tooltip": tooltip}, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    printf '%s\n' '{"text":"󰚰","class":"good","tooltip":"Harmonia status unavailable"}'
    exit 0
fi

printf '%s\n' "$rendered"
