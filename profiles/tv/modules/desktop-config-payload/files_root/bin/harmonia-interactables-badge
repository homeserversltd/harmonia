#!/usr/bin/env bash
set -u

payload="$(harmonia interactable list --json 2>/dev/null)" || {
    printf '%s\n' '{"text":"","class":"ok","tooltip":"Harmonia interactables unavailable"}'
    exit 0
}

if ! rendered="$(HARMONIA_INTERACTABLES_PAYLOAD="$payload" python3 - <<'PY'
import json
import os

payload = json.loads(os.environ["HARMONIA_INTERACTABLES_PAYLOAD"])
if isinstance(payload, dict):
    rows = payload.get("interactables", payload.get("items", []))
elif isinstance(payload, list):
    rows = payload
else:
    raise ValueError("unsupported interactables payload")
if not isinstance(rows, list):
    raise ValueError("interactables must be a list")

pending = []
for row in rows:
    if not isinstance(row, dict):
        continue
    state = str(row.get("state", row.get("status", "pending"))).strip().lower()
    if state in {"ok", "clean", "applied", "complete", "completed"}:
        continue
    pending.append(row)

names = [str(row.get("name") or row.get("id") or "unnamed interactable") for row in pending]
tooltip = "Harmonia: no pending interactables" if not names else "Harmonia pending:\n" + "\n".join(f"• {name}" for name in names[:5])
print(json.dumps({
    "text": "" if not names else f"󰚰 {len(names)}",
    "class": "ok" if not names else "pending",
    "tooltip": tooltip,
}, ensure_ascii=False, separators=(",", ":")))
PY
)"; then
    printf '%s\n' '{"text":"","class":"ok","tooltip":"Harmonia interactables unavailable"}'
    exit 0
fi

printf '%s\n' "$rendered"
