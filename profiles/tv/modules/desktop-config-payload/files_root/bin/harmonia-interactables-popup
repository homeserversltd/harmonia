#!/usr/bin/env bash
set -u -o pipefail

readonly PROFILE_INDEX="${HARMONIA_PROFILE_INDEX:-/etc/harmonia/profiles/tv/index.json}"
readonly TOGGLE_BIN="/usr/local/sbin/caduceus-harmonia-module-toggle"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Harmonia updates" "$1"
}

pending_records() {
    harmonia interactable list --json 2>/dev/null | python3 -c '
import json
import sys

try:
    payload = json.load(sys.stdin)
except (json.JSONDecodeError, OSError):
    payload = {}
for row in payload.get("interactables", []) if isinstance(payload, dict) else []:
    if not isinstance(row, dict):
        continue
    ident = str(row.get("id") or "").strip()
    if not ident:
        continue
    name = str(row.get("name") or ident).replace("\t", " ").replace("\n", " ")
    print(f"{ident}\t{name}")
'
}

module_records() {
    [[ -x "$TOGGLE_BIN" && -f "$PROFILE_INDEX" ]] || return 0

    local states
    states="$(sudo -n "$TOGGLE_BIN" list 2>/dev/null)" || return 0
    python3 -c '
import json
import sys
from pathlib import Path

try:
    profile = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    receipt = json.load(sys.stdin)
except (json.JSONDecodeError, OSError):
    raise SystemExit(0)
if not isinstance(profile, dict) or not isinstance(receipt, dict) or receipt.get("ok") is not True:
    raise SystemExit(0)
disabled = receipt.get("disabled_modules")
if not isinstance(disabled, list) or not all(isinstance(module, str) for module in disabled):
    raise SystemExit(0)
for module in profile.get("modules", []):
    if not isinstance(module, str) or not module:
        continue
    state = "Disabled" if module in disabled else "Enabled"
    action = "on" if state == "Disabled" else "off"
    print(f"{module}\t{state}\t{action}")
' "$PROFILE_INDEX" <<<"$states"
}

apply_interactable() {
    local ident="$1"
    if sudo -n harmonia interactable run "$ident" >/dev/null; then
        notify "Applied update: $ident"
    else
        notify "Could not apply update: $ident"
    fi
}

toggle_module() {
    local module="$1"
    local action="$2"
    if sudo -n "$TOGGLE_BIN" "$module" "$action" >/dev/null; then
        notify "$module: turned $action"
    else
        notify "Could not turn $action $module"
    fi
}

if (( $# > 1 )) || [[ "${1:-popup}" != "popup" ]]; then
    exit 2
fi

mapfile -t pending < <(pending_records)

if ! command -v fuzzel >/dev/null 2>&1; then
    if ((${#pending[@]})); then
        pending_names=()
        for record in "${pending[@]}"; do
            IFS=$'\t' read -r _ name <<<"$record"
            pending_names+=("$name")
        done
        notify $'Pending updates:\n'"$(printf '%s\n' "${pending_names[@]}")"
    else
        notify "No pending updates."
    fi
    exit 0
fi

rows=()
action_kinds=()
action_first=()
action_second=()
for record in "${pending[@]}"; do
    IFS=$'\t' read -r ident name <<<"$record"
    rows+=("Apply: $name")
    action_kinds+=("apply")
    action_first+=("$ident")
    action_second+=("")
done

mapfile -t modules < <(module_records)
for record in "${modules[@]}"; do
    IFS=$'\t' read -r module state action <<<"$record"
    if [[ "$state" == "Enabled" ]]; then
        rows+=("$module: Enabled - turn off")
    else
        rows+=("$module: Disabled - turn on")
    fi
    action_kinds+=("toggle")
    action_first+=("$module")
    action_second+=("$action")
done

((${#rows[@]})) || exit 0
selection="$(printf '%s\n' "${rows[@]}" | fuzzel --dmenu --prompt "Harmonia ")" || exit 0
[[ -n "$selection" ]] || exit 0

for index in "${!rows[@]}"; do
    [[ "${rows[$index]}" == "$selection" ]] || continue
    case "${action_kinds[$index]}" in
        apply) apply_interactable "${action_first[$index]}" ;;
        toggle) toggle_module "${action_first[$index]}" "${action_second[$index]}" ;;
    esac
    exit 0
done

exit 0
