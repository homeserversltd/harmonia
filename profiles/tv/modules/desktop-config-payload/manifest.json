{
  "schema": "harmonia.module.ladder.v1",
  "id": "desktop-config-payload",
  "category": "interactable",
  "version": "1.0.0",
  "description": "TV residual manifest/prompt/game-launcher payload is converged from this module.",
  "optional": false,
  "constants": {
    "target_dir": "/home/owner",
    "expected_files": [
      "MANIFEST.captured.txt",
      "SANITIZATION.md",
      "omp.json",
      "/etc/arch-tv/steam-gamescope-policy.md",
      "/usr/local/bin/arch-tv-steam-gamescope",
      "/usr/share/applications/arch-tv-steam-gamescope.desktop"
    ],
    "phase": 5,
    "receipt_schema": "harmonia.tv.desktop_config_payload.v1",
    "meaning": "TV residual manifest/prompt/game-launcher payload is converged from this module."
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "manifest",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/manifest",
        "target_root": "$constants.target_dir",
        "files": [
          "MANIFEST.captured.txt",
          "SANITIZATION.md"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tv-desktop-config-manifest"
      }
    },
    {
      "step_id": "prompt",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/prompt",
        "target_root": "$constants.target_dir",
        "files": [
          "omp.json"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tv-desktop-config-prompt"
      }
    },
    {
      "step_id": "game-launcher",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/game-launcher",
        "target_root": "/",
        "files": [
          "etc/arch-tv/steam-gamescope-policy.md",
          "usr/local/bin/arch-tv-steam-gamescope",
          "usr/share/applications/arch-tv-steam-gamescope.desktop"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "tv-desktop-config-game-launcher"
      }
    }
  ]
}
