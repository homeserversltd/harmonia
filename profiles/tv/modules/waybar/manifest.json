{
  "schema": "harmonia.module.ladder.v1",
  "id": "waybar",
  "category": "interactable",
  "version": "1.0.0",
  "description": "Converges the Waybar config and user unit, declares hs-waybar.service for census, and reloads the owner user manager.",
  "optional": false,
  "constants": {
    "target_dir": "/home/owner",
    "target_user": "owner",
    "expected_files": [
      ".config/systemd/user/hs-waybar.service",
      ".config/waybar/style.css",
      ".config/waybar/waybar.conf"
    ],
    "user_services": [
      "hs-waybar.service"
    ],
    "phase": 6,
    "receipt_schema": "harmonia.tv.waybar.v1",
    "meaning": "TV Waybar status service owns its configuration and user service"
  },
  "ladder": [
    {
      "step_id": "managed-files",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "$constants.target_dir",
        "files": [
          ".config/systemd/user/hs-waybar.service",
          ".config/waybar/style.css",
          ".config/waybar/waybar.conf"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tv-waybar-files",
        "summary_receipt": {
          "name": "tv-waybar-files-summary",
          "schema": "harmonia.tv.desktop_config_install.v1",
          "authority": "harmonia-profile-module-owned-files",
          "first_missing_signal": "tv-desktop-config-files-incomplete"
        }
      }
    },
    {
      "step_id": "user-daemon-reload",
      "tool": "systemd",
      "permutation": "user-daemon-reload",
      "args": {
        "user": "$constants.target_user",
        "timeout_secs": 60
      }
    }
  ],
  "files_root": "files_root"
}
