{
  "schema": "harmonia.module.ladder.v1",
  "id": "operator-rc-profile",
  "category": "Presented",
  "version": "1.0.0",
  "description": "TV operator rc profile. This module is the sole owner and converger of the operator shell rc set, including the Fulcrum PATH export, zsh helpers, Oh My Posh config paths, and bin helpers; oh-my-posh package currentness remains owned by oh-my-posh-aur-ratchet.",
  "optional": false,
  "constants": {
    "packages": [
      "zsh",
      "zsh-autosuggestions",
      "zsh-syntax-highlighting",
      "fzf",
      "atuin"
    ],
    "target_dir": "/home/owner",
    "expected_files": [
      ".aliases",
      ".functions",
      ".inputrc",
      ".nanorc",
      ".profile",
      ".zshrc",
      "omp.json",
      ".config/omp.json",
      "bin/waybar-meter.sh",
      "bin/volume.sh"
    ],
    "phase": 4,
    "receipt_schema": "harmonia.tv.operator_rc_profile.v1",
    "meaning": "operator rc files, including the Fulcrum PATH export, are maintained only by operator-rc-profile; oh-my-posh package currentness is owned by oh-my-posh-aur-ratchet"
  },
  "ladder": [
    {
      "step_id": "operator-rc-managed-files",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/shell-rc",
        "target_root": "$constants.target_dir",
        "files": [
          ".aliases",
          ".functions",
          ".inputrc",
          ".nanorc",
          ".profile",
          ".zshrc"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "tv-operator-shell-rc"
      },
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
