{
  "schema": "harmonia.module.ladder.v1",
  "id": "install-caduceus",
  "category": "known-good",
  "config_deploy": "interactable",
  "version": "1.1.1",
  "description": "TV module installs and maintains Caduceus. It syncs source, builds and installs the binary, maintains profile, policy, and state files, and manages the Caduceus service and health checks.",
  "optional": false,
  "constants": {},
  "ladder": [
    {
      "step_id": "caduceus-bootstrap-source-from-declared-profile",
      "tool": "git-artifact",
      "permutation": "sync",
      "args": {
        "component": "caduceus",
        "path": "/opt/caduceus/source",
        "source_dir": "/opt/caduceus/source"
      }
    },
    {
      "step_id": "caduceus-service-runtime",
      "tool": "service-runtime",
      "permutation": "converge",
      "args": {
        "module_id": "install-caduceus",
        "component": "caduceus",
        "registry_base": "https://git.home.arpa/api/packages/HOMESERVERSLTD/generic",
        "source_dir": "/opt/caduceus/source",
        "install_bin": "/usr/local/bin/caduceus",
        "service": "caduceus.service",
        "url": "http://127.0.0.1:8787/health",
        "binary_name": "caduceus",
        "op_prefix": "caduceus",
        "run_schema": "harmonia.tv.install_caduceus.v1",
        "managed_files_schema": "harmonia.tv.caduceus_managed_files.v1",
        "managed_files": [
          {
            "path": "/etc/caduceus/policies/update.json",
            "operation": "place",
            "mode": 420,
            "content": "{\n  \"schema\": \"caduceus.policy.v1\",\n  \"profile\": \"tv\",\n  \"allowed_public_actions\": [\n    \"identity show\",\n    \"profile show\",\n    \"health\",\n    \"receipts latest\",\n    \"update status\",\n    \"update check\",\n    \"update now\",\n    \"update service status\",\n    \"update service toggle on\",\n    \"update service toggle off\",\n    \"cert status\",\n    \"cert issue-leaf\",\n    \"cert rotate-ca\",\n    \"cert bundle create\"\n  ],\n  \"private_land_organs_exposed\": false\n}\n"
          },
          {
            "path": "/var/lib/caduceus/state.json",
            "operation": "place",
            "mode": 420,
            "content": "{\n  \"schema\": \"caduceus.state.v1\",\n  \"services\": {\n    \"update\": {\n      \"enabled\": true,\n      \"timer\": \"harmonia.timer\"\n    }\n  }\n}\n",
            "xattrs": {},
            "no_follow": true,
            "collision_policy": "refuse",
            "rollback_policy": "exact",
            "uid": 0,
            "gid": 0
          }
        ],
        "caduceus_profile_source": {
          "source": "profiles/tv/index.yaml",
          "path": "/etc/caduceus/profile.yaml",
          "mode": 420,
          "append": ""
        }
      }
    }
  ],
  "files_root": "files_root"
}
