{
  "schema": "harmonia.module.ladder.v1",
  "id": "hyprland-desktop",
  "version": "1.0.0",
  "description": "TV hyprland-desktop module. Rust owns Hyprland, portals, desktop shell, browser, audio, and KDE integration packages are maintained; this sidecar carries constants only.",
  "optional": false,
  "constants": {
    "packages": [
      "hyprland",
      "uwsm",
      "waybar",
      "dunst",
      "swayidle",
      "wl-clipboard",
      "chromium",
      "xdg-desktop-portal",
      "xdg-desktop-portal-hyprland",
      "xdg-desktop-portal-gtk",
      "polkit-kde-agent",
      "dolphin",
      "kate",
      "kcalc",
      "zsh",
      "fzf",
      "wofi",
      "pavucontrol",
      "pipewire",
      "wireplumber",
      "pipewire-pulse",
      "pipewire-alsa",
      "alsa-utils",
      "kitty",
      "jq"
    ],
    "binaries": [
      "Hyprland",
      "waybar",
      "dunst",
      "chromium",
      "pipewire",
      "wireplumber"
    ],
    "phase": 3,
    "receipt_schema": "harmonia.tv.hyprland_desktop.v1",
    "meaning": "Hyprland, portals, desktop shell, browser, audio, and KDE integration packages are maintained"
  },
  "ladder": [
    {
      "step_id": "packages-install",
      "tool": "package",
      "permutation": "install",
      "args": {
        "packages": "$constants.packages",
        "timeout_secs": 1800
      }
    },
    {
      "step_id": "binary-hyprland",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "Hyprland"
      }
    },
    {
      "step_id": "binary-waybar",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "waybar"
      }
    },
    {
      "step_id": "binary-dunst",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "dunst"
      }
    },
    {
      "step_id": "binary-chromium",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "chromium"
      }
    },
    {
      "step_id": "binary-pipewire",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "pipewire"
      }
    },
    {
      "step_id": "binary-wireplumber",
      "tool": "files",
      "permutation": "executable-present",
      "args": {
        "executable": "wireplumber"
      }
    }
  ]
}
