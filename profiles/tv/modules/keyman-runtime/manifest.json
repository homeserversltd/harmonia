{
  "schema": "harmonia.module.ladder.v1",
  "id": "keyman-runtime",
  "category": "known-good",
  "version": "3.7.0",
  "description": "TV Keyman source ladder: synchronize Keyman into /opt/keyman/source.",
  "constants": {},
  "ladder": [
    {
      "step_id": "keyman-source-repository",
      "tool": "git-artifact",
      "permutation": "sync",
      "args": {
        "component": "keyman",
        "path": "/opt/keyman/source"
      }
    },
    {
      "step_id": "keyman-rust-release",
      "tool": "release-binary",
      "permutation": "install",
      "args": {
        "component": "keyman",
        "asset": "keyman-x86_64",
        "path": "/vault/keyman/keyman",
        "mode": 493
      }
    },
    {
      "step_id": "keyman-runtime-install",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "python3",
        "args": [
          "-I",
          "/opt/keyman/source/index.py",
          "install",
          "--profile",
          "vault-only",
          "--source-dir",
          "/opt/keyman/source"
        ],
        "observation": {
          "kind": "module_changed_before_step"
        }
      }
    }
  ]
}
