{
  "schema": "harmonia.module.ladder.v1",
  "id": "household-time",
  "version": "1.0.0",
  "optional": false,
  "description": "Household time unwatched consumer: applies the public UTC fallback idempotently and always ensures NTP.",
  "role": "unwatched-consumer",
  "caduceus_commands": [
    "time ensure-ntp",
    "time set-timezone"
  ],
  "ladder": [
    {
      "step_id": "household-time-set-utc",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/local/bin/caduceus",
        "args": [
          "time",
          "set-timezone",
          "Etc/UTC"
        ],
        "timeout_secs": 15
      }
    },
    {
      "step_id": "household-time-ensure-ntp",
      "tool": "command",
      "permutation": "capture",
      "args": {
        "program": "/usr/local/bin/caduceus",
        "args": [
          "time",
          "ensure-ntp"
        ],
        "timeout_secs": 15
      }
    }
  ]
}
