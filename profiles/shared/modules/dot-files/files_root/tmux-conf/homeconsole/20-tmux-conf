# --- Core Logic & Isolation ---
# Ensure panes are NEVER synced by default
set-window-option -g synchronize-panes off
# Toggle synchronization with Prefix + y (DISABLED to prevent accidental broadcasting)
# bind y setw synchronize-panes
# Instead, we unbind y completely:
unbind y
# Isolation: Allow multiple clients to have different window sizes
setw -g aggressive-resize on

# Status/header disabled for tiny-box resource conservation.
# The previous polling header was backed up before this change.
set -g status off
set -g status-interval 0
set -g status-left ''
set -g status-right ''
setw -g window-status-current-format ''
setw -g window-status-format ''

set -g history-limit 10000
setw -g automatic-rename on

bind s choose-session
bind c new-window
bind -n M-Left previous-window
bind -n M-Right next-window

bind r source-file ~/.tmux.conf \; display-message "Config reloaded!"
# Clear any stale follow-bottom hooks from prior experiments so reloads converge.
set-hook -gu client-attached
set-hook -gu client-resized

bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

set-option -g default-shell /bin/zsh

# Enable mouse support
set-option -g mouse on
# Mouse-wheel tuning: scroll 8 lines per wheel tick in tmux copy mode.
# When scrolling back down to the live bottom, exit copy mode automatically.
unbind -T root WheelUpStatus
unbind -T root WheelDownStatus
bind -T root WheelUpPane if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -e \; send-keys -X scroll-up"
bind -T copy-mode-vi WheelUpPane select-pane \; send-keys -X -N 8 scroll-up
bind -T copy-mode-vi WheelDownPane select-pane \; send-keys -X -N 8 scroll-down
bind -T copy-mode WheelUpPane select-pane \; send-keys -X -N 8 scroll-up
bind -T copy-mode WheelDownPane select-pane \; send-keys -X -N 8 scroll-down
setw -g alternate-screen on

# Copy selection to system clipboard
set -as terminal-features ',*:clipboard'
set -g set-clipboard on
set -g @override_copy_command 'xclip -i -selection clipboard'
set -g @yank_selection 'clipboard'

# Initialize TPM (Tmux Plugin Manager)
run '~/.tmux/plugins/tpm/tpm'

# Clipboard/yank plugin only; status/header telemetry plugins removed for resource conservation.
set -g @plugin 'tmux-plugins/tmux-yank'
