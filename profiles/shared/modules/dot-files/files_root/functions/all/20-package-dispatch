_install_programs() { procure "$@"; }
_uninstall_programs() { uninstall_programs "$@"; }
procure() { case "$(_pkg)" in apt) _install_programs_apt "$@";; pacman) _install_programs_pacman "$@";; *) return 1;; esac; }
uninstall_programs() { case "$(_pkg)" in apt) _uninstall_programs_apt "$@";; pacman) _uninstall_programs_pacman "$@";; *) return 1;; esac; }
purge() { case "$(_pkg)" in apt) _uninstall_programs_apt "$@";; pacman) _uninstall_programs_pacman "$@";; *) return 1;; esac; }
find.program() { case "$(_pkg)" in apt) _find_program_apt "$@";; pacman) _find_program_pacman "$@";; *) return 1;; esac; }
alias install='procure'
alias get='procure'
alias remove='purge'
alias uninstall='purge'
alias delete='purge'
