check_authorship() {
    echo "=== AUTHORSHIP VERIFICATION ==="
    echo "Current directory: $(pwd)"
    echo "Repository: $(basename $(git rev-parse --show-toplevel))"
    echo "Git Name: $(git config user.name)"
    echo "Git Email: $(git config user.email)"
    echo "Remote URL: $(git remote get-url origin 2>/dev/null || echo 'No remote')"
    echo "==============================="

    # Verify correct identity based on repository
    local repo_path=$(git rev-parse --show-toplevel)
    if [[ "$repo_path" == *"serverGenesis"* ]] || [[ "$repo_path" == *"homeserversltd"* ]]; then
        if [[ "$(git config user.name)" != "homeserversltd" ]] || [[ "$(git config user.email)" != "owner@arpaservers.com" ]]; then
            echo "❌ WRONG IDENTITY! Expected: homeserversltd <owner@arpaservers.com>"
            echo "Current: $(git config user.name) <$(git config user.email)>"
            return 1
        fi
    elif [[ "$repo_path" == *"singletons"* ]] || [[ "$repo_path" == *"koltanl"* ]]; then
        if [[ "$(git config user.name)" != "koltanl" ]] || [[ "$(git config user.email)" != "koltanl@users.noreply.github.com" ]]; then
            echo "❌ WRONG IDENTITY! Expected: koltanl <koltanl@users.noreply.github.com>"
            echo "Current: $(git config user.name) <$(git config user.email)>"
            return 1
        fi
    fi
    echo "✅ Identity verified!"
    return 0
}

case "$(_appliance)" in
    tv|homeconsole) alias git-check="check_authorship" ;;
esac
