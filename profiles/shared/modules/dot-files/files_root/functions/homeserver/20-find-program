find.program() {
    if [ -z "$1" ]; then
        echo "Usage: find_program <program_name>"
        return 1
    fi
    local query="$1"
    echo "Searching in apt repository..."
    apt_results=$(apt-cache search "$query" | grep -E '^[a-z0-9.+-]+' | awk '{print $1}')
    echo "Searching for files..."
    file_results=$(apt-file search "$query" | grep -E '^[a-z0-9.+-]+' | awk -F: '{print $1}')
    echo -e "$apt_results\n$file_results" | fzf --ansi --multi --preview 'echo {}'
}
