{
  "schema": "harmonia.module.ladder.v1",
  "id": "chromium",
  "version": "1.1.0",
  "description": "Shared Chromium configuration module: it solely owns Chromium launch flags, recommended settings, managed extensions, and retraction of its retired profile-named mandatory policy artifacts.",
  "optional": false,
  "constants": {
    "retired_mandatory_policy_paths": [
      "etc/chromium/policies/managed/laptop-chromium-policy.json",
      "etc/chromium/policies/managed/arch-tv-chromium-policy.json"
    ]
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "chromium-flags-file",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "home/owner/.config/chromium-flags.conf"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "chromium-flags-file"
      }
    },
    {
      "step_id": "chromium-policy-files",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/chromium/policies/recommended/harmonia-chromium-policy.json",
          "etc/chromium/policies/managed/harmonia-chromium-extensions.json"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "chromium-policy-files"
      }
    },
    {
      "step_id": "retired-mandatory-policy-cleanup",
      "tool": "files",
      "permutation": "remove",
      "args": {
        "target_root": "/",
        "paths": "$constants.retired_mandatory_policy_paths"
      }
    }
  ]
}
