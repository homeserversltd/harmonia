{
  "schema": "harmonia.touch.resolved.v1",
  "schema_version": "1.0.0",
  "role": "The resolved touch pool is generated by build.rs from the profile's modules and committed at schema/touch/resolved/<profile>.json. A plain build refuses a stale file; HARMONIA_WRITE_RESOLVED=1 regenerates it. A path in no array is never. The lists are sorted.",
  "authority": {
    "owner": "harmonia",
    "path": "schema/harmonia.touch.resolved.v1.json",
    "grant": "Harmonia's own seat for its generated per-profile touch pool"
  },
  "evolution": {
    "law": "additive-only",
    "missing_field_semantics": "An absent optional note adds no description",
    "unknown_fields_preserved": true
  },
  "fields": {
    "schema": {
      "type": "string",
      "const": "harmonia.touch.resolved.v1"
    },
    "profile": {
      "type": "string"
    },
    "interactable": {
      "type": "array",
      "items": {
        "type_ref": "Row"
      }
    },
    "hotfix": {
      "type": "array",
      "items": {
        "type_ref": "Row"
      }
    },
    "clobbered": {
      "type": "array",
      "items": {
        "type_ref": "Row"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type_ref": "OperationRow"
      }
    }
  },
  "field_types": {
    "schema": "string",
    "profile": "string",
    "interactable": "array<Row>",
    "hotfix": "array<Row>",
    "clobbered": "array<Row>",
    "operations": "array<OperationRow>"
  },
  "required": [
    "schema",
    "profile",
    "interactable",
    "hotfix",
    "clobbered",
    "operations"
  ],
  "optional": [],
  "types": {
    "Row": {
      "fields": {
        "path": {
          "type": "string",
          "description": "Absolute touch pattern; * matches one segment, ** matches any depth, and no .. segment is permitted."
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "module",
        "step",
        "tool"
      ],
      "optional": [
        "note"
      ]
    },
    "OperationRow": {
      "fields": {
        "kind": {
          "type": "string",
          "enum": [
            "package",
            "package-upgrade",
            "command",
            "unit"
          ]
        },
        "match": {
          "type": "string"
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "match",
        "module",
        "step"
      ],
      "optional": []
    }
  },
  "canonical_bytes": "UTF-8 JSON, two-space indentation and one trailing LF"
}
