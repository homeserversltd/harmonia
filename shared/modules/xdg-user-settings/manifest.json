{
  "schema": "harmonia.module.ladder.v1",
  "id": "xdg-user-settings",
  "title": "App defaults",
  "summary": "Chooses default apps for files and helps KDE programs see installed apps, open links, and show dialogs.",
  "category": "interactable",
  "version": "1.2.0",
  "description": "TV KDE/application associations and portal configuration are maintained in the owner home, and a root menu lets KDE programs see installed apps.",
  "optional": false,
  "constants": {
    "target_dir": "/home/owner",
    "expected_files": [
      ".config/kde-mimeapps.list",
      ".config/mimeapps.list",
      ".config/xdg-desktop-portal/sway-portals.conf",
      ".local/share/applications/mimeapps.list",
      ".local/share/applications/org.kde.kate.desktop"
    ],

    "receipt_schema": "harmonia.hometv.xdg_user_settings.v1",
    "meaning": "TV KDE/application associations and portal configuration are converged from this module into the owner home."
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "kde-and-associations",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/kde-applications",
        "target_root": "$constants.target_dir",
        "files": [
          ".config/kde-mimeapps.list",
          ".config/mimeapps.list",
          ".local/share/applications/mimeapps.list",
          ".local/share/applications/org.kde.kate.desktop"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "hometv-xdg-user-settings-kde"
      }
    },
    {
      "step_id": "portal",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/portal",
        "target_root": "$constants.target_dir",
        "files": [
          ".config/xdg-desktop-portal/sway-portals.conf"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "hometv-xdg-user-settings-portal"
      }
    },
    {
      "step_id": "kde-root-menu",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root/menus",
        "target_root": "/",
        "files": [
          "etc/xdg/menus/applications.menu"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "hometv-xdg-user-settings-kde-root-menu"
      }
    }
  ]
}
