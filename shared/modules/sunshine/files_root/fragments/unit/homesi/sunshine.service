[Unit]
Description=Sunshine owner desktop stream
Requires=sway-seat.service
After=sway-seat.service hometv-sway-environment.service hometv-sway-session.target
Requisite=hometv-sway-session.target
PartOf=hometv-sway-session.target
BindsTo=sway-seat.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
ExecCondition=/usr/bin/test -n "${WAYLAND_DISPLAY}"
ExecStartPre=/usr/bin/swaymsg --quiet --socket=${SWAYSOCK} --type=get_version
ExecStart=/usr/bin/sunshine /home/owner/.config/sunshine/sunshine.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=hometv-sway-session.target
