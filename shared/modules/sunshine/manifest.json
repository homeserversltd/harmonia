{
  "schema": "harmonia.module.ladder.v1",
  "id": "sunshine",
  "title": "Desktop streaming",
  "summary": "Keeps streaming configuration and approved device access ready for other screens.",
  "category": "known-good",
  "version": "1.1.0",
  "optional": false,
  "description": "Shared Sunshine configuration and device rule: console retains its gamepad bytes; HomeSI captures the owner Sway desktop and enables only its owner services. Birth supplies all binaries.",
  "constants": {},
  "ladder": [
    {
      "step_id": "sunshine-user-config",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/config",
        "target_path": "/home/owner/.config/sunshine/sunshine.conf",
        "mode": 420,
        "backup_existing": true,
        "owner": "owner",
        "group": "owner"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sunshine-device-access",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "/",
        "files": [
          "etc/udev/rules.d/60-sunshine.rules"
        ],
        "backup_existing": true,
        "owner": "root",
        "group": "root",
        "receipt_name": "homeconsole-sunshine-device-access"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sunshine-owner-unit",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/unit",
        "target_path": "/home/owner/.config/systemd/user/sunshine.service",
        "mode": 420,
        "backup_existing": true,
        "owner": "owner",
        "group": "owner"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "owner-desktop-streaming-services",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/bin/python3",
        "args": [
          "${module_dir}/owner-services.py",
          "apply"
        ],
        "bearer": "owner",
        "timeout_secs": 100,
        "skip_if_absent": "/home/owner/.config/systemd/user/sunshine.service",
        "observation": {
          "program": "/usr/bin/python3",
          "args": [
            "${module_dir}/owner-services.py",
            "check"
          ],
          "bearer": "owner",
          "expected_exit_code": 0,
          "expected_stdout": "current"
        }
      },
      "on_failure": "stop"
    }
  ],
  "files_root": "files_root"
}
