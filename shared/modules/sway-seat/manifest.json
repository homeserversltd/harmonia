{
  "schema": "harmonia.module.ladder.v1",
  "id": "sway-seat",
  "title": "Owner desktop seat",
  "summary": "Keeps the selected owner desktop and support-screen definitions current.",
  "category": "known-good",
  "version": "1.0.1",
  "description": "Preserves existing support-seat pools; the HomeSI pool links a Debian owner full-desktop unit. The shared Sunshine job owns HomeSI-only enablement; all Hermes seat modules remain separate.",
  "optional": false,
  "config_deploy": "interactable",
  "constants": {
    "packages": [
      "sway",
      "wayvnc",
      "foot",
      "wtype",
      "python"
    ],
    "packages_by_family": {
      "arch": [
        "sway",
        "wayvnc",
        "foot",
        "wtype",
        "python"
      ],
      "ubuntu": [
        "sway",
        "wayvnc",
        "foot",
        "wlrctl",
        "wtype",
        "python3-venv"
      ],
      "debian": [
        "sway",
        "wayvnc",
        "foot",
        "wlrctl",
        "wtype",
        "python3-venv"
      ]
    }
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "sway-seat-packages-present",
      "tool": "package",
      "permutation": "check",
      "args": {
        "packages": "$constants.packages"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sway-seat-session-helper",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/session-helper",
        "target_path": "/usr/local/libexec/sway-seat/sway-seat-session",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sway-seat-readiness-helper",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/ready-helper",
        "target_path": "/usr/local/libexec/sway-seat/sway-seat-wait-ready",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sway-seat-runtime-tmpfiles",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/tmpfiles",
        "target_path": "/etc/tmpfiles.d/sway-seat.conf",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sway-seat-owner-unit",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/owner-sway-unit",
        "target_path": "/home/owner/.config/systemd/user/sway-seat.service",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sway-seat-owner-wayvnc-unit",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/owner-wayvnc-unit",
        "target_path": "/home/owner/.config/systemd/user/wayvnc-seat.service",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "sway-seat-user-manager-reload",
      "tool": "systemd",
      "permutation": "user-daemon-reload",
      "args": {
        "user": "owner",
        "timeout_secs": 60
      },
      "on_failure": "stop"
    }
  ]
}
