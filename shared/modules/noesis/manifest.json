{
  "schema": "harmonia.module.ladder.v1",
  "id": "noesis",
  "title": "HomeSI controls",
  "summary": "Keeps the Noesis control website available on port 3015.",
  "category": "known-good",
  "version": "1.1.0",
  "description": "Shared Noesis face runtime: fetch its own repository release artifact, promote the binary, place its unit with the selected Caduceus origin, restart only for changed material, and check HTTP health. Noesis defaults to 0.0.0.0:3015.",
  "files_root": "files_root",
  "profile_input": {
    "axis": "profile",
    "fragment": "runtime.json",
    "fallback": "specula"
  },
  "constants": {},
  "ladder": [
    {
      "step_id": "noesis-service-runtime",
      "tool": "service-runtime",
      "permutation": "converge",
      "args": {
        "module_id": "noesis",
        "component": "noesis",
        "bearer": "owner",
        "source_dir": "/opt/noesis/source",
        "source_sha_file": "/var/lib/harmonia/state/noesis.sha",
        "install_bin": "/usr/local/bin/noesis",
        "service": "noesis.service",
        "url": "http://127.0.0.1:3015/health",
        "retries": 30,
        "binary_name": "noesis",
        "release_repo": "HOMESERVERSLTD/noesis",
        "profile_axis": "profile",
        "identity": "embedded-sha",
        "op_prefix": "noesis",
        "run_schema": "harmonia.noesis_runtime.v1",
        "managed_files_schema": "harmonia.noesis_runtime.managed_files.v1",
        "build_environment": {
          "RUSTUP_HOME": "/opt/rustup",
          "CARGO_HOME": "/opt/cargo"
        },
        "managed_files": [
          {
            "path": "/etc/systemd/system/noesis.service",
            "mode": 420,
            "content": "[Unit]\nDescription=Noesis HomeSI face\n\n[Service]\nType=simple\nUser=root\nGroup=root\nEnvironment=NOESIS_CADUCEUS_URL=${unit_environment.NOESIS_CADUCEUS_URL}\nExecStart=/usr/local/bin/noesis\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n"
          }
        ],
        "expected_unit_properties": {
          "User": "root",
          "Group": "root"
        }
      },
      "on_failure": "stop"
    }
  ]
}
