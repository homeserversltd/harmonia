{
  "schema": "harmonia.module.ladder.v1",
  "id": "cua-driver",
  "title": "Screen control",
  "summary": "Keeps the screen-control helper current and its support screen ready.",
  "category": "known-good",
  "version": "1.0.0",
  "description": "Keep the pinned 0.28.2 CUA release upkeep helper with local currentness observation; the profile lists the shared screen supervisor separately.",
  "constants": {
    "release_repo": "trycua/cua",
    "release_tag": "cua-driver-rs-v0.28.2",
    "archive": "cua-driver-rs-0.28.2-linux-x86_64.tar.gz",
    "archive_sha256": "8f3e5b669e2bcd98d0eecc64f40640aac77f358b6332a06abc6ee79991620f7d",
    "binary_sha256": "3739101d072bdfdd83b7e70b3a16d9271f6eb124e7c5e69b3406f20f0910a4ca",
    "binary_member": "cua-driver-rs-0.28.2-linux-x86_64/cua-driver",
    "entrypoint": "/usr/local/bin/cua-driver"
  },
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "cua-driver-maintenance-helper",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/cua-driver-maintain",
        "target_path": "/usr/local/libexec/sway-seat/cua-driver-maintain",
        "mode": 493,
        "uid": 0,
        "gid": 0,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "cua-driver-pinned-release-currentness",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/local/libexec/sway-seat/cua-driver-maintain",
        "args": [
          "apply",
          "$constants.release_repo",
          "$constants.release_tag",
          "$constants.archive",
          "$constants.archive_sha256",
          "$constants.binary_member",
          "$constants.binary_sha256"
        ],
        "timeout_secs": 180,
        "observation": {
          "program": "/usr/local/libexec/sway-seat/cua-driver-maintain",
          "args": [
            "observe",
            "$constants.release_repo",
            "$constants.release_tag",
            "$constants.archive",
            "$constants.archive_sha256",
            "$constants.binary_member",
            "$constants.binary_sha256"
          ],
          "expected_exit_code": 0,
          "expected_stdout": "current"
        }
      },
      "on_failure": "stop"
    }
  ]
}
