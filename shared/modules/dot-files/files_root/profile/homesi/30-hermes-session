# Reopen a detached conversation without disturbing another client.
_homesi_hermes_session() {
  [[ -o interactive && -t 0 && -z ${TMUX:-} && -z ${NO_AUTO_TMUX:-} ]] || return
  local hermes_bin tty_name preferred name attached activity last pane session_id fresh best='' best_pane=-1 best_activity=-1 best_last=-1
  local -a sessions panes fields
  command -v tmux >/dev/null 2>&1 || return
  hermes_bin=$(command -v hermes) || return
  tty_name=$(tty) || return
  tty_name=${tty_name#/dev/}
  preferred="ssh-${tty_name//\//-}"
  sessions=("${(@f)$(tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_activity}|#{session_last_attached}' 2>/dev/null)}")
  panes=("${(@f)$(tmux list-panes -a -F '#{session_name}|#{pane_current_command}' 2>/dev/null)}")
  for line in "${sessions[@]}"; do
    fields=("${(@s:|:)line}")
    (( ${#fields} == 4 )) || continue
    name=$fields[1] attached=$fields[2] activity=${fields[3]:-0} last=${fields[4]:-0}
    [[ $attached == 0 && ( $name == hermes* || $name == ssh-* ) ]] || continue
    if [[ $name == $preferred ]]; then
      best=$name
      break
    fi
    pane=0
    for line in "${panes[@]}"; do
      [[ $line == "$name|hermes" || $line == "$name|python" || $line == "$name|python3" ]] && pane=1
    done
    if (( pane > best_pane || (pane == best_pane && activity > best_activity) || (pane == best_pane && activity == best_activity && last > best_last) )); then
      best=$name best_pane=$pane best_activity=$activity best_last=$last
    fi
  done
  fresh="hermes-$(date +%H%M%S)-$$"
  if [[ -n $best ]]; then
    session_id=$(tmux display-message -p -t "=$best:" '#{session_id}') || return
    [[ -n $session_id ]] || return
    # Decide and attach in one tmux command queue, not from the snapshot.
    exec tmux if-shell -F -t "${session_id}:" '#{==:#{session_attached},0}' \
      "attach-session -t ${(q)session_id}" \
      "new-session -s ${(q)fresh} ${(q)hermes_bin}"
  fi
  if tmux has-session -t '=hermes' 2>/dev/null; then
    exec tmux new-session -s "$fresh" "$hermes_bin"
  fi
  tmux new-session -s hermes "$hermes_bin" 2>/dev/null && return
  # A concurrent login may have created the canonical session meanwhile.
  tmux has-session -t '=hermes' 2>/dev/null || return
  exec tmux new-session -s "$fresh" "$hermes_bin"
}
_homesi_hermes_session
unfunction _homesi_hermes_session
