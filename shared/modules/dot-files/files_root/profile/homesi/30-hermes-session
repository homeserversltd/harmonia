# Reopen a detached conversation without disturbing another client.
_homesi_hermes_session() (
  case $- in *i*) ;; *) return ;; esac
  [ -t 0 ] && [ -z "${TMUX:-}" ] && [ -z "${NO_AUTO_TMUX:-}" ] || return
  command -v tmux >/dev/null 2>&1 || return
  hermes_bin=$(command -v hermes) || return
  tty_name=$(tty) || return
  preferred="ssh-$(printf '%s' "${tty_name#/dev/}" | tr '/' '-')"
  sessions=$(tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_activity}|#{session_last_attached}' 2>/dev/null)
  panes=$(tmux list-panes -a -F '#{session_name}|#{pane_current_command}' 2>/dev/null)
  best=$(printf '%s\n' "$sessions" | awk -F '|' -v preferred="$preferred" -v panes="$panes" '
    BEGIN {
      count = split(panes, rows, "\n")
      for (i = 1; i <= count; i++) {
        split(rows[i], p, "|")
        if (p[2] == "hermes" || p[2] == "python" || p[2] == "python3") good[p[1]] = 1
      }
      best_pane = best_activity = best_last = -1
    }
    $2 == "0" && ($1 ~ /^hermes/ || $1 ~ /^ssh-/) {
      if ($1 == preferred) { exact = $1; next }
      pane = good[$1] + 0; activity = $3 + 0; last = $4 + 0
      if (pane > best_pane || (pane == best_pane && activity > best_activity) ||
          (pane == best_pane && activity == best_activity && last > best_last)) {
        best = $1; best_pane = pane; best_activity = activity; best_last = last
      }
    }
    END { if (exact != "") print exact; else if (best != "") print best }
  ')
  fresh="hermes-$(date +%H%M%S)-$$"
  if [ -n "$best" ]; then
    session_id=$(tmux display-message -p -t "=$best:" '#{session_id}') || return
    [ -n "$session_id" ] || return
    # Decide and attach in one tmux command queue, not from the snapshot.
    quoted_hermes=$(printf '%s' "$hermes_bin" | sed "s/'/'\\\\''/g")
    exec tmux if-shell -F -t "${session_id}:" '#{==:#{session_attached},0}' \
      "attach-session -t '$session_id'" \
      "new-session -s '$fresh' '$quoted_hermes'"
  fi
  if tmux has-session -t '=hermes' 2>/dev/null; then
    exec tmux new-session -s "$fresh" "$hermes_bin"
  fi
  tmux new-session -s hermes "$hermes_bin" 2>/dev/null && return
  # A concurrent login may have created the canonical session meanwhile.
  tmux has-session -t '=hermes' 2>/dev/null || return
  exec tmux new-session -s "$fresh" "$hermes_bin"
)
_homesi_hermes_session
unset -f _homesi_hermes_session
