{
  "schema": "harmonia.module.ladder.v1",
  "id": "hermes-gateway-service",
  "title": "Hermes messaging gateway service",
  "summary": "Offers Hermes gateway as a foreground user service.",
  "category": "interactable",
  "version": "1.0.1",
  "description": "Compile the Ubuntu-only foreground Hermes gateway unit with the Hermes home and private Wayland runtime; birth owns linger activation and credentials.",
  "optional": false,
  "config_deploy": "interactable",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "hermes-gateway-user-unit",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/service",
        "target_path": "/home/hermes/.config/systemd/user/hermes-gateway.service",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    },
    {
      "step_id": "hermes-gateway-user-daemon-reload",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/bin/systemctl",
        "args": [
          "--user",
          "--machine=hermes@.host",
          "daemon-reload"
        ],
        "timeout_secs": 60,
        "observation": {
          "kind": "module_changed_before_step"
        }
      },
      "on_failure": "stop"
    },
    {
      "step_id": "hermes-gateway-user-restart",
      "tool": "command",
      "permutation": "act",
      "args": {
        "program": "/usr/bin/systemctl",
        "args": [
          "--user",
          "--machine=hermes@.host",
          "try-restart",
          "hermes-gateway.service"
        ],
        "timeout_secs": 60,
        "observation": {
          "kind": "module_changed_before_step"
        }
      },
      "on_failure": "stop"
    }
  ]
}
