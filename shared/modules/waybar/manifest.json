{
  "schema": "harmonia.module.ladder.v1",
  "id": "waybar",
  "title": "Status bar",
  "summary": "Shows status and quick controls in the bar along the bottom of the screen.",
  "category": "interactable",
  "version": "1.1.6",
  "description": "One shared owner status-bar job; TV keeps its face controls and HomeSI selects native desktop controls through its profile pool.",
  "optional": false,
  "constants": {
    "target_dir": "/home/owner",
    "target_user": "owner",
    "expected_files": [
      ".config/systemd/user/hs-waybar.service",
      ".config/systemd/user/hs-nm-applet.service",
      ".config/systemd/user/hs-blueman-applet.service",
      ".config/waybar/style.css",
      ".config/waybar/badge-state.css",
      ".config/waybar/waybar.conf"
    ],
    "user_services": [
      "hs-waybar.service",
      "hs-nm-applet.service",
      "hs-blueman-applet.service"
    ],

    "receipt_schema": "harmonia.hometv.waybar.v1",
    "meaning": "TV Waybar status service owns its configuration and user service"
  },
  "ladder": [
    {
      "step_id": "managed-files",
      "tool": "files",
      "permutation": "converge",
      "args": {
        "source_root": "files_root",
        "target_root": "$constants.target_dir",
        "files": [
          ".config/systemd/user/hs-waybar.service",
          ".config/systemd/user/hs-nm-applet.service",
          ".config/systemd/user/hs-blueman-applet.service",
          ".config/waybar/style.css",
          ".config/waybar/badge-state.css"
        ],
        "backup_existing": true,
        "owner": "owner",
        "group": "owner",
        "receipt_name": "hometv-waybar-files",
        "summary_receipt": {
          "name": "hometv-waybar-files-summary",
          "schema": "harmonia.hometv.desktop_config_install.v1",
          "authority": "harmonia-profile-module-owned-files",
          "first_missing_signal": "hometv-desktop-config-files-incomplete"
        }
      }
    },
    {
      "step_id": "desktop-status-values",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/fragments/config",
        "target_path": "/home/owner/.config/waybar/waybar.conf",
        "mode": 420,
        "backup_existing": true,
        "owner": "owner",
        "group": "owner"
      },
      "on_failure": "stop"
    },
    {
      "step_id": "user-daemon-reload",
      "tool": "systemd",
      "permutation": "user-daemon-reload",
      "args": {
        "user": "$constants.target_user",
        "timeout_secs": 60
      }
    }
  ],
  "files_root": "files_root"
}
