[Unit]
Description=HOMESERVER Waybar
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStartPre=-/usr/bin/pkill --exact --uid %U waybar
ExecStart=/usr/bin/waybar -c /home/owner/.config/waybar/waybar.conf -s /home/owner/.config/waybar/style.css
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
