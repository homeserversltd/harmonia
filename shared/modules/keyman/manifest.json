{
  "schema": "harmonia.module.ladder.v1",
  "id": "keyman",
  "title": "Secure access",
  "summary": "Keeps approved household access and recovery features available.",
  "category": "known-good",
  "version": "3.8.0",
  "description": "Synchronize compatibility source and update the Keyman binary from its digest-verified pinned release; birth and key custody remain outside Harmonia.",
  "constants": {},
  "ladder": [
    {
      "step_id": "keyman-source",
      "tool": "git-artifact",
      "permutation": "sync",
      "args": {
        "component": "keyman",
        "bearer": "owner",
        "path": "/opt/keyman/source"
      }
    },
    {
      "step_id": "keyman-rust-release",
      "tool": "release-binary",
      "permutation": "install",
      "args": {
        "component": "keyman",
        "asset": "keyman-x86_64",
        "pinned_release_sha": "6d91637143dea192824f45d72b02e3d652afd456",
        "path": "/vault/keyman/keyman",
        "mode": 493
      }
    }
  ]
}
