{
  "schema": "harmonia.module.ladder.v1",
  "id": "hermes-dashboard-service",
  "title": "Hermes dashboard service",
  "summary": "Offers the Hermes dashboard as a foreground user service.",
  "category": "interactable",
  "version": "1.0.0",
  "description": "Compile the Hermes dashboard user unit; birth owns linger activation and credentials.",
  "optional": false,
  "config_deploy": "interactable",
  "constants": {},
  "files_root": "files_root",
  "ladder": [
    {
      "step_id": "hermes-dashboard-user-unit",
      "tool": "files",
      "permutation": "compile-fragments",
      "args": {
        "source_root": "files_root/service",
        "target_path": "/home/hermes/.config/systemd/user/hermes-dashboard.service",
        "mode": 420,
        "backup_existing": true
      },
      "on_failure": "stop"
    }
  ]
}
