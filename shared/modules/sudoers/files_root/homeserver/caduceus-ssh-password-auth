# Coronatio SSH password-authentication policy: exact live-config commands only.
caduceus ALL=(root) NOPASSWD: /usr/sbin/sshd -T
caduceus ALL=(root) NOPASSWD: /usr/bin/sed -i -E s/^\[\[\:space\:\]\]\*PasswordAuthentication\[\[\:space\:\]\]+(yes|no)\[\[\:space\:\]\]\*(\#.*)\?$/PasswordAuthentication\ yes/I /etc/ssh/sshd_config
caduceus ALL=(root) NOPASSWD: /usr/bin/sed -i -E s/^\[\[\:space\:\]\]\*PasswordAuthentication\[\[\:space\:\]\]+(yes|no)\[\[\:space\:\]\]\*(\#.*)\?$/PasswordAuthentication\ no/I /etc/ssh/sshd_config
caduceus ALL=(root) NOPASSWD: /usr/sbin/sshd -t
caduceus ALL=(root) NOPASSWD: /usr/bin/systemctl reload ssh.service
caduceus ALL=(root) NOPASSWD: /usr/bin/systemctl reload sshd.service
