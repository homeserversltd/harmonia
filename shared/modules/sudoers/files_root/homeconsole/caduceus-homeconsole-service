# HomeConsole HTTP crossings not shared by the HomeServer or TV source profile.
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings display
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings appearance
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings sound
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings notifications
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings default-apps
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings datetime
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py settings/input
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py games/provider-keys
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py games/sync
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py console/restart
caduceus ALL=(root) NOPASSWD: /usr/local/bin/harmonia ^update-module /etc/harmonia/profiles/homeconsole/index\.json --module [A-Za-z0-9._-]+( --apply)?$
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py storage/vault/policy
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py storage/vault/open
caduceus ALL=(root) NOPASSWD: /usr/bin/cat /etc/crypttab
caduceus ALL=(root) NOPASSWD: /usr/sbin/blkid ^-s UUID -o value (/dev/(sd[a-z]+[0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)|/dev/disk/by-partlabel/[A-Za-z0-9_-][A-Za-z0-9_.-]*)$
caduceus ALL=(root) NOPASSWD: /usr/bin/tee /etc/crypttab
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup ^open --batch-mode --key-file - (/dev/(sd[a-z]+[0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)|/dev/disk/by-partlabel/[A-Za-z0-9_-][A-Za-z0-9_.-]*) [A-Za-z0-9_.-]{1\,128}$
caduceus ALL=(root) NOPASSWD: /usr/bin/mkdir -p /vault
caduceus ALL=(root) NOPASSWD: /usr/bin/mount ^/dev/mapper/[A-Za-z0-9_.-]{1\,128} /vault$
