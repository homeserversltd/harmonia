# Common Caduceus HTTP/process-start crossings for all three appliance pools.
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py exousia bind
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py exousia verify
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py exousia change
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py exousia reset-default
caduceus ALL=(root) NOPASSWD: /usr/local/bin/harmonia update --apply
caduceus ALL=(root) NOPASSWD: /usr/local/bin/harmonia update
caduceus ALL=(root) NOPASSWD: /usr/local/bin/harmonia interactable list --json
caduceus ALL=(root) NOPASSWD: /usr/local/bin/harmonia ^interactable run [A-Za-z0-9._-]+$
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py network/wifi
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py network/dhcp
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py storage/vault/policy
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py storage/vault/open
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/caduceus-forgejo-credential
caduceus ALL=(root) NOPASSWD: /usr/bin/cat /etc/crypttab
caduceus ALL=(root) NOPASSWD: /usr/sbin/blkid ^-s UUID -o value (/dev/(sd[a-z]+[0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)|/dev/disk/by-partlabel/[A-Za-z0-9_-][A-Za-z0-9_.-]*)$
caduceus ALL=(root) NOPASSWD: /usr/bin/tee /etc/crypttab
caduceus ALL=(root) NOPASSWD: /usr/sbin/cryptsetup ^open --batch-mode --key-file - (/dev/(sd[a-z]+[0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)|/dev/disk/by-partlabel/[A-Za-z0-9_-][A-Za-z0-9_.-]*) [A-Za-z0-9_.-]{1\,128}$
caduceus ALL=(root) NOPASSWD: /usr/bin/mkdir -p /vault
caduceus ALL=(root) NOPASSWD: /usr/bin/mount ^/dev/mapper/[A-Za-z0-9_.-]{1\,128} /vault$
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py storage/upload/ingress
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/agathodaimon/cli.py storage/upload/force-permissions
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/caduceus-house-ca status
caduceus ALL=(root) NOPASSWD: /usr/local/sbin/caduceus-house-ca ^trust-install (/[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)*)+ --platform (windows|android|chromeos|linux|macos)( --dry-run)?$
