{
  "schema": "harmonia.touch.v1",
  "allow": [
    {
      "path": "/usr/local/bin/harmonia",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/var/lib/harmonia/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/run/harmonia/*.lock",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/etc/systemd/system/harmonia.timer",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-external-release-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-pinned-release-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-xenia-release-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-release-probe-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-release-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-pinned-engine-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-module-observe-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-pinned-archive-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/tmp/harmonia-xenia-stage-*/**",
      "lanes": [
        "self"
      ]
    },
    {
      "path": "/boot/grub/grub.cfg",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/boot/grub/themes/homeserver",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/etc/default/grub",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/etc/sudoers.d/caduceus-*",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/etc/systemd/system/mkdocs.service",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.aliases",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.bash-preexec.sh",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.bashrc",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.enhanced_less_config",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.functions",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.gitconfig",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.inputrc",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.lesskey",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.nanorc",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.profile",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.tmux.conf",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.zshenv",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/home/owner/.zshrc",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/opt/caduceus/source",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/opt/docs/docs",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/docs/mkdocs.yml",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/opt/docs/source",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/keyman/source",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/sbin/source",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/root/.bashrc",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/root/.profile",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/usr/local/bin/agathodaimon",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/usr/local/bin/caduceus",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/usr/local/sbin/agathodaimon",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/usr/local/sbin/agathodaimon/**",
      "lanes": [
        "known-good"
      ],
      "note": "Kept current by the sbin source-shelf-sweep step."
    },
    {
      "path": "/var/lib/caduceus/venv",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/var/lib/harmonia/state/documentation-docs-sweep.json",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/var/lib/harmonia/state/sbin-source-shelf-sweep.json",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/vault/keyman/keyman",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/boot/grub/themes/homeserver/**",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/caduceus/source/**",
      "lanes": [
        "interactable"
      ]
    },
    {
      "path": "/opt/docs/docs/**",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/docs/source/**",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/keyman/source/**",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/opt/sbin/source/**",
      "lanes": [
        "known-good"
      ]
    },
    {
      "path": "/var/lib/caduceus/venv/**",
      "lanes": [
        "known-good"
      ]
    }
  ],
  "never": [
    "/etc/appliance/profile.json",
    "/etc/appliance/config.factory",
    "/etc/shadow",
    "/etc/gshadow",
    "/etc/sudoers",
    "/**/.ssh/**",
    "/**/*.key",
    "/**/*.pem"
  ],
  "operations": [
    {
      "kind": "unit",
      "match": "harmonia.timer",
      "lanes": [
        "self"
      ]
    },
    {
      "kind": "command",
      "match": "/usr/bin/chsh",
      "lanes": [
        "interactable"
      ]
    },
    {
      "kind": "command",
      "match": "/usr/bin/python3",
      "lanes": [
        "interactable",
        "known-good"
      ]
    },
    {
      "kind": "command",
      "match": "/usr/bin/systemd-analyze",
      "lanes": [
        "interactable"
      ]
    },
    {
      "kind": "unit",
      "match": "caduceus.service",
      "lanes": [
        "interactable"
      ]
    },
    {
      "kind": "package-upgrade",
      "match": "*",
      "lanes": [
        "known-good"
      ],
      "note": "The system-packages upgrade selects the installed package set dynamically."
    }
  ]
}
